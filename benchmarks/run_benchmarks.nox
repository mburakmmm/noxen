# benchmarks/run_benchmarks.nox — Performance benchmarks for Noxen.

import nox.time
from nox.time import Instant
import noxen
import models
import core
from noxen import Schema, ValidatedData, Serializer
from models import ModelSchema, BidirectionalModel
from core import Result

class User:
    name: str
    age: int
    email: str

    def __init__(self: User, name: str, age: int, email: str) -> None:
        self.name = name
        self.age = age
        self.email = email

    def to_json(self: User) -> str:
        s: Serializer = Serializer()
        s.str("name", self.name)
        s.int("age", self.age)
        s.str("email", self.email)
        return s.build()

class Address:
    city: str
    country: str
    def __init__(self: Address, city: str, country: str) -> None:
        self.city = city
        self.country = country

class Company:
    name: str
    address: Address
    def __init__(self: Company, name: str, address: Address) -> None:
        self.name = name
        self.address = address

# Setup schemas
user_schema: Schema = Schema("User")
user_schema.field_str("name").min_length(2)
user_schema.field_int("age").min(0.0)
user_schema.field_str("email").email()

def make_user(d: ValidatedData) -> User:
    return User(d.get_str("name"), d.get_int("age"), d.get_str("email"))

def unparse_user(u: User) -> ValidatedData:
    d: ValidatedData = ValidatedData()
    d.set_str("name", u.name)
    d.set_int("age", u.age)
    d.set_str("email", u.email)
    return d

user_model: ModelSchema[User] = ModelSchema[User](user_schema, make_user)
user_bi: BidirectionalModel[User] = BidirectionalModel[User](user_model, unparse_user)

addr_schema: Schema = Schema("Address")
addr_schema.field_str("city")
addr_schema.field_str("country")

def make_addr(d: ValidatedData) -> Address:
    return Address(d.get_str("city"), d.get_str("country"))

comp_schema: Schema = Schema("Company")
comp_schema.field_str("name")
comp_schema.field_object("address", addr_schema)

def make_comp(d: ValidatedData) -> Company:
    return Company(d.get_str("name"), make_addr(d.get_object("address")))

comp_model: ModelSchema[Company] = ModelSchema[Company](comp_schema, make_comp)

# Setup 4-level deep hierarchy: Enterprise -> Org -> Dept
class Dept:
    code: str
    budget: int
    def __init__(self, code: str, budget: int) -> None:
        self.code = code
        self.budget = budget

class Org:
    title: str
    dept: Dept
    def __init__(self, title: str, dept: Dept) -> None:
        self.title = title
        self.dept = dept

class Enterprise:
    corp_name: str
    org: Org
    def __init__(self, corp_name: str, org: Org) -> None:
        self.corp_name = corp_name
        self.org = org

dept_s: Schema = Schema("Dept")
dept_s.field_str("code")
dept_s.field_int("budget").min_i(0)

def make_dept(d: ValidatedData) -> Dept:
    return Dept(d.get_str("code"), d.get_int("budget"))

org_s: Schema = Schema("Org")
org_s.field_str("title")
org_s.field_object("dept", dept_s)

def make_org(d: ValidatedData) -> Org:
    return Org(d.get_str("title"), make_dept(d.get_object("dept")))

ent_s: Schema = Schema("Enterprise")
ent_s.field_str("corp_name")
ent_s.field_object("org", org_s)

def make_ent(d: ValidatedData) -> Enterprise:
    return Enterprise(d.get_str("corp_name"), make_org(d.get_object("org")))

ent_model: ModelSchema[Enterprise] = ModelSchema[Enterprise](ent_s, make_ent)

flat_json: str = "{\"name\":\"Ada Lovelace\",\"age\":36,\"email\":\"ada@example.com\"}"
nested_json: str = "{\"name\":\"Acme Corp\",\"address\":{\"city\":\"San Francisco\",\"country\":\"USA\"}}"
invalid_json: str = "{\"name\":\"A\",\"age\":\"not-int\",\"email\":\"bad-email\"}"
deep_json: str = "{\"corp_name\":\"OmniCorp Global\",\"org\":{\"title\":\"Engineering\",\"dept\":{\"code\":\"ENG-01\",\"budget\":5000000}}}"

ITERATIONS: int = 5000
WARMUP_ITERS: int = 500

def median3(a: int, b: int, c: int) -> int:
    if (a >= b and a <= c) or (a <= b and a >= c):
        return a
    if (b >= a and b <= c) or (b <= a and b >= c):
        return b
    return c

print("Running Noxen Benchmarks (" + str(ITERATIONS) + " iterations, 3 trials, median timing, with warmup)...")
print("------------------------------------------------------------------------------------------------")

# Benchmark 1: Flat Model Parsing
# Warmup
w1: int = 0
while w1 < WARMUP_ITERS:
    r_w1: Result[User] = user_model.parse_json(flat_json)
    w1 = w1 + 1

# Trial 1
t1_a: Instant = nox.time.instant_now()
i1_a: int = 0
chk1: int = 0
while i1_a < ITERATIONS:
    r1_a: Result[User] = user_model.parse_json(flat_json)
    chk1 = chk1 + r1_a.unwrap().age
    i1_a = i1_a + 1
el1_a: int = t1_a.elapsed_ms()

# Trial 2
t1_b: Instant = nox.time.instant_now()
i1_b: int = 0
while i1_b < ITERATIONS:
    r1_b: Result[User] = user_model.parse_json(flat_json)
    chk1 = chk1 + r1_b.unwrap().age
    i1_b = i1_b + 1
el1_b: int = t1_b.elapsed_ms()

# Trial 3
t1_c: Instant = nox.time.instant_now()
i1_c: int = 0
while i1_c < ITERATIONS:
    r1_c: Result[User] = user_model.parse_json(flat_json)
    chk1 = chk1 + r1_c.unwrap().age
    i1_c = i1_c + 1
el1_c: int = t1_c.elapsed_ms()

elapsed1: int = median3(el1_a, el1_b, el1_c)
if elapsed1 <= 0:
    elapsed1 = 1
ops_sec1: int = int((float(ITERATIONS) / (float(elapsed1) / 1000.0)))
print("1. Flat Model Parsing:          ", elapsed1, "ms (median) | ", ops_sec1, "ops/sec")

# Benchmark 2: Nested Model Parsing
w2: int = 0
while w2 < WARMUP_ITERS:
    r_w2: Result[Company] = comp_model.parse_json(nested_json)
    w2 = w2 + 1

t2_a: Instant = nox.time.instant_now()
j2_a: int = 0
chk2: int = 0
while j2_a < ITERATIONS:
    r2_a: Result[Company] = comp_model.parse_json(nested_json)
    chk2 = chk2 + len(r2_a.unwrap().name)
    j2_a = j2_a + 1
el2_a: int = t2_a.elapsed_ms()

t2_b: Instant = nox.time.instant_now()
j2_b: int = 0
while j2_b < ITERATIONS:
    r2_b: Result[Company] = comp_model.parse_json(nested_json)
    chk2 = chk2 + len(r2_b.unwrap().name)
    j2_b = j2_b + 1
el2_b: int = t2_b.elapsed_ms()

t2_c: Instant = nox.time.instant_now()
j2_c: int = 0
while j2_c < ITERATIONS:
    r2_c: Result[Company] = comp_model.parse_json(nested_json)
    chk2 = chk2 + len(r2_c.unwrap().name)
    j2_c = j2_c + 1
el2_c: int = t2_c.elapsed_ms()

elapsed2: int = median3(el2_a, el2_b, el2_c)
if elapsed2 <= 0:
    elapsed2 = 1
ops_sec2: int = int((float(ITERATIONS) / (float(elapsed2) / 1000.0)))
print("2. Nested Model Parsing:        ", elapsed2, "ms (median) | ", ops_sec2, "ops/sec")

# Benchmark 3: Invalid Payload Rejection
w3: int = 0
while w3 < WARMUP_ITERS:
    r_w3: Result[User] = user_model.parse_json(invalid_json)
    w3 = w3 + 1

t3_a: Instant = nox.time.instant_now()
k3_a: int = 0
chk3: int = 0
while k3_a < ITERATIONS:
    r3_a: Result[User] = user_model.parse_json(invalid_json)
    chk3 = chk3 + len(r3_a.errors)
    k3_a = k3_a + 1
el3_a: int = t3_a.elapsed_ms()

t3_b: Instant = nox.time.instant_now()
k3_b: int = 0
while k3_b < ITERATIONS:
    r3_b: Result[User] = user_model.parse_json(invalid_json)
    chk3 = chk3 + len(r3_b.errors)
    k3_b = k3_b + 1
el3_b: int = t3_b.elapsed_ms()

t3_c: Instant = nox.time.instant_now()
k3_c: int = 0
while k3_c < ITERATIONS:
    r3_c: Result[User] = user_model.parse_json(invalid_json)
    chk3 = chk3 + len(r3_c.errors)
    k3_c = k3_c + 1
el3_c: int = t3_c.elapsed_ms()

elapsed3: int = median3(el3_a, el3_b, el3_c)
if elapsed3 <= 0:
    elapsed3 = 1
ops_sec3: int = int((float(ITERATIONS) / (float(elapsed3) / 1000.0)))
print("3. Invalid Payload Reject:      ", elapsed3, "ms (median) | ", ops_sec3, "ops/sec")

# Benchmark 4: Model JSON Round-Trip (Programmatic Serializer)
sample_user: User = User("Ada Lovelace", 36, "ada@example.com")
w4: int = 0
while w4 < WARMUP_ITERS:
    s_w4: str = sample_user.to_json()
    r_w4: Result[User] = user_model.parse_json(s_w4)
    w4 = w4 + 1

t4_a: Instant = nox.time.instant_now()
m4_a: int = 0
chk4: int = 0
while m4_a < ITERATIONS:
    s_out_a: str = sample_user.to_json()
    r4_a: Result[User] = user_model.parse_json(s_out_a)
    chk4 = chk4 + r4_a.unwrap().age
    m4_a = m4_a + 1
el4_a: int = t4_a.elapsed_ms()

t4_b: Instant = nox.time.instant_now()
m4_b: int = 0
while m4_b < ITERATIONS:
    s_out_b: str = sample_user.to_json()
    r4_b: Result[User] = user_model.parse_json(s_out_b)
    chk4 = chk4 + r4_b.unwrap().age
    m4_b = m4_b + 1
el4_b: int = t4_b.elapsed_ms()

t4_c: Instant = nox.time.instant_now()
m4_c: int = 0
while m4_c < ITERATIONS:
    s_out_c: str = sample_user.to_json()
    r4_c: Result[User] = user_model.parse_json(s_out_c)
    chk4 = chk4 + r4_c.unwrap().age
    m4_c = m4_c + 1
el4_c: int = t4_c.elapsed_ms()

elapsed4: int = median3(el4_a, el4_b, el4_c)
if elapsed4 <= 0:
    elapsed4 = 1
ops_sec4: int = int((float(ITERATIONS) / (float(elapsed4) / 1000.0)))
print("4. Full JSON Round-Trip:        ", elapsed4, "ms (median) | ", ops_sec4, "ops/sec")

# Benchmark 5: Deeply Nested Hierarchy (3-Level Deep Model)
w5: int = 0
while w5 < WARMUP_ITERS:
    r_w5: Result[Enterprise] = ent_model.parse_json(deep_json)
    w5 = w5 + 1

t5_a: Instant = nox.time.instant_now()
q5_a: int = 0
chk5: int = 0
while q5_a < ITERATIONS:
    r5_a: Result[Enterprise] = ent_model.parse_json(deep_json)
    chk5 = chk5 + len(r5_a.unwrap().corp_name)
    q5_a = q5_a + 1
el5_a: int = t5_a.elapsed_ms()

t5_b: Instant = nox.time.instant_now()
q5_b: int = 0
while q5_b < ITERATIONS:
    r5_b: Result[Enterprise] = ent_model.parse_json(deep_json)
    chk5 = chk5 + len(r5_b.unwrap().corp_name)
    q5_b = q5_b + 1
el5_b: int = t5_b.elapsed_ms()

t5_c: Instant = nox.time.instant_now()
q5_c: int = 0
while q5_c < ITERATIONS:
    r5_c: Result[Enterprise] = ent_model.parse_json(deep_json)
    chk5 = chk5 + len(r5_c.unwrap().corp_name)
    q5_c = q5_c + 1
el5_c: int = t5_c.elapsed_ms()

elapsed5: int = median3(el5_a, el5_b, el5_c)
if elapsed5 <= 0:
    elapsed5 = 1
ops_sec5: int = int((float(ITERATIONS) / (float(elapsed5) / 1000.0)))
print("5. Deep Hierarchy Parsing (3L): ", elapsed5, "ms (median) | ", ops_sec5, "ops/sec")

# Benchmark 6: Bidirectional Automated Model Dump (Reflection-Free Fast Path)
w6: int = 0
while w6 < WARMUP_ITERS:
    d_w6: str = user_bi.to_json(sample_user)
    w6 = w6 + 1

t6_a: Instant = nox.time.instant_now()
w6_a: int = 0
chk6: int = 0
while w6_a < ITERATIONS:
    dumped_a: str = user_bi.to_json(sample_user)
    chk6 = chk6 + len(dumped_a)
    w6_a = w6_a + 1
el6_a: int = t6_a.elapsed_ms()

t6_b: Instant = nox.time.instant_now()
w6_b: int = 0
while w6_b < ITERATIONS:
    dumped_b: str = user_bi.to_json(sample_user)
    chk6 = chk6 + len(dumped_b)
    w6_b = w6_b + 1
el6_b: int = t6_b.elapsed_ms()

t6_c: Instant = nox.time.instant_now()
w6_c: int = 0
while w6_c < ITERATIONS:
    dumped_c: str = user_bi.to_json(sample_user)
    chk6 = chk6 + len(dumped_c)
    w6_c = w6_c + 1
el6_c: int = t6_c.elapsed_ms()

elapsed6: int = median3(el6_a, el6_b, el6_c)
if elapsed6 <= 0:
    elapsed6 = 1
ops_sec6: int = int((float(ITERATIONS) / (float(elapsed6) / 1000.0)))
print("6. Fast Model Dump (bi):        ", elapsed6, "ms (median) | ", ops_sec6, "ops/sec")

# Benchmark 7: Validated Model Dump (dump_validated with Output Re-validation)
w7_warm: int = 0
while w7_warm < WARMUP_ITERS:
    d_w7: str = user_bi.dump_validated(sample_user)
    w7_warm = w7_warm + 1

t7_a: Instant = nox.time.instant_now()
w7_a: int = 0
chk7: int = 0
while w7_a < ITERATIONS:
    dumped_v_a: str = user_bi.dump_validated(sample_user)
    chk7 = chk7 + len(dumped_v_a)
    w7_a = w7_a + 1
el7_a: int = t7_a.elapsed_ms()

t7_b: Instant = nox.time.instant_now()
w7_b: int = 0
while w7_b < ITERATIONS:
    dumped_v_b: str = user_bi.dump_validated(sample_user)
    chk7 = chk7 + len(dumped_v_b)
    w7_b = w7_b + 1
el7_b: int = t7_b.elapsed_ms()

t7_c: Instant = nox.time.instant_now()
w7_c: int = 0
while w7_c < ITERATIONS:
    dumped_v_c: str = user_bi.dump_validated(sample_user)
    chk7 = chk7 + len(dumped_v_c)
    w7_c = w7_c + 1
el7_c: int = t7_c.elapsed_ms()

elapsed7: int = median3(el7_a, el7_b, el7_c)
if elapsed7 <= 0:
    elapsed7 = 1
ops_sec7: int = int((float(ITERATIONS) / (float(elapsed7) / 1000.0)))
print("7. Validated Model Dump (chk):  ", elapsed7, "ms (median) | ", ops_sec7, "ops/sec")

# Prevent dead code elimination across all benchmarks
total_checksum: int = chk1 + chk2 + chk3 + chk4 + chk5 + chk6 + chk7
if total_checksum == 0:
    print("Warning: checksum zero")

print("-----------------------------------------------------------------")
print("Benchmark complete.")
