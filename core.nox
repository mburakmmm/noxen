# core.nox — Validated data container and result types for Noxen.

import errors
from errors import FieldError, ValidationError
import nox.json
from nox.json import JsonWriter

class ValidatedData:
    _strs: dict[str, str]
    _ints: dict[str, int]
    _floats: dict[str, float]
    _bools: dict[str, bool]
    _list_strs: dict[str, list[str]]
    _list_ints: dict[str, list[int]]
    _list_floats: dict[str, list[float]]
    _list_bools: dict[str, list[bool]]
    _list_objs_len: dict[str, int]
    _nulls: list[str]
    _present: list[str]
    _extras: dict[str, str]
    _extra_keys: list[str]
    _prefix: str

    def __init__(self: ValidatedData) -> None:
        self._strs = {}
        self._ints = {}
        self._floats = {}
        self._bools = {}
        self._list_strs = {}
        self._list_ints = {}
        self._list_floats = {}
        self._list_bools = {}
        self._list_objs_len = {}
        self._nulls = []
        self._present = []
        self._extras = {}
        self._extra_keys = []
        self._prefix = ""

    def set_str(self: ValidatedData, k: str, v: str) -> None:
        pk: str = self._prefix + k
        self._strs[pk] = v
        self._present.append(pk)

    def set_int(self: ValidatedData, k: str, v: int) -> None:
        pk: str = self._prefix + k
        self._ints[pk] = v
        self._present.append(pk)

    def set_float(self: ValidatedData, k: str, v: float) -> None:
        pk: str = self._prefix + k
        self._floats[pk] = v
        self._present.append(pk)

    def set_bool(self: ValidatedData, k: str, v: bool) -> None:
        pk: str = self._prefix + k
        self._bools[pk] = v
        self._present.append(pk)

    def set_object(self: ValidatedData, k: str, v: ValidatedData) -> None:
        pk: str = self._prefix + k
        self._present.append(pk)
        sub_pfx: str = pk + "."
        vpfx_len: int = len(v._prefix)
        pi: int = 0
        while pi < len(v._present):
            orig_k: str = v._present[pi]
            clean_k: str = orig_k
            if vpfx_len > 0 and len(clean_k) >= vpfx_len and clean_k[0:vpfx_len] == v._prefix:
                clean_k = clean_k[vpfx_len:len(clean_k)]
            target_k: str = sub_pfx + clean_k
            self._present.append(target_k)
            if orig_k in v._strs:
                self._strs[target_k] = v._strs[orig_k]
            if orig_k in v._ints:
                self._ints[target_k] = v._ints[orig_k]
            if orig_k in v._floats:
                self._floats[target_k] = v._floats[orig_k]
            if orig_k in v._bools:
                self._bools[target_k] = v._bools[orig_k]
            if orig_k in v._list_strs:
                self._list_strs[target_k] = v._list_strs[orig_k]
            if orig_k in v._list_ints:
                self._list_ints[target_k] = v._list_ints[orig_k]
            if orig_k in v._list_floats:
                self._list_floats[target_k] = v._list_floats[orig_k]
            if orig_k in v._list_bools:
                self._list_bools[target_k] = v._list_bools[orig_k]
            if orig_k in v._list_objs_len:
                self._list_objs_len[target_k] = v._list_objs_len[orig_k]
            if orig_k in v._extras:
                self._extras[target_k] = v._extras[orig_k]
                self._extra_keys.append(target_k)
            if v.is_null(clean_k):
                self._nulls.append(target_k)
            pi = pi + 1

    def set_list_str(self: ValidatedData, k: str, v: list[str]) -> None:
        pk: str = self._prefix + k
        self._list_strs[pk] = v
        self._present.append(pk)

    def set_list_int(self: ValidatedData, k: str, v: list[int]) -> None:
        pk: str = self._prefix + k
        self._list_ints[pk] = v
        self._present.append(pk)

    def set_list_float(self: ValidatedData, k: str, v: list[float]) -> None:
        pk: str = self._prefix + k
        self._list_floats[pk] = v
        self._present.append(pk)

    def set_list_bool(self: ValidatedData, k: str, v: list[bool]) -> None:
        pk: str = self._prefix + k
        self._list_bools[pk] = v
        self._present.append(pk)

    def set_list_object(self: ValidatedData, k: str, v: list[ValidatedData]) -> None:
        pk: str = self._prefix + k
        self._present.append(pk)
        self._list_objs_len[pk] = len(v)
        idx: int = 0
        while idx < len(v):
            item: ValidatedData = v[idx]
            item_pfx: str = pk + "[" + str(idx) + "]."
            vpfx_len: int = len(item._prefix)
            pi: int = 0
            while pi < len(item._present):
                orig_k: str = item._present[pi]
                clean_k: str = orig_k
                if vpfx_len > 0 and len(clean_k) >= vpfx_len and clean_k[0:vpfx_len] == item._prefix:
                    clean_k = clean_k[vpfx_len:len(clean_k)]
                target_k: str = item_pfx + clean_k
                self._present.append(target_k)
                if orig_k in item._strs:
                    self._strs[target_k] = item._strs[orig_k]
                if orig_k in item._ints:
                    self._ints[target_k] = item._ints[orig_k]
                if orig_k in item._floats:
                    self._floats[target_k] = item._floats[orig_k]
                if orig_k in item._bools:
                    self._bools[target_k] = item._bools[orig_k]
                if orig_k in item._list_strs:
                    self._list_strs[target_k] = item._list_strs[orig_k]
                if orig_k in item._list_ints:
                    self._list_ints[target_k] = item._list_ints[orig_k]
                if orig_k in item._list_floats:
                    self._list_floats[target_k] = item._list_floats[orig_k]
                if orig_k in item._list_bools:
                    self._list_bools[target_k] = item._list_bools[orig_k]
                if orig_k in item._list_objs_len:
                    self._list_objs_len[target_k] = item._list_objs_len[orig_k]
                if orig_k in item._extras:
                    self._extras[target_k] = item._extras[orig_k]
                    self._extra_keys.append(target_k)
                if item.is_null(clean_k):
                    self._nulls.append(target_k)
                pi = pi + 1
            idx = idx + 1

    def set_null(self: ValidatedData, k: str) -> None:
        pk: str = self._prefix + k
        self._nulls.append(pk)
        self._present.append(pk)

    def set_opt_str(self: ValidatedData, k: str, v: str | None) -> None:
        if v is None:
            self.set_null(k)
        else:
            self.set_str(k, v)

    def set_opt_int(self: ValidatedData, k: str, v: int | None) -> None:
        if v is None:
            self.set_null(k)
        else:
            self.set_int(k, v)

    def set_opt_float(self: ValidatedData, k: str, v: float | None) -> None:
        if v is None:
            self.set_null(k)
        else:
            self.set_float(k, v)

    def set_opt_bool(self: ValidatedData, k: str, v: bool | None) -> None:
        if v is None:
            self.set_null(k)
        else:
            self.set_bool(k, v)

    def has(self: ValidatedData, k: str) -> bool:
        pk: str = self._prefix + k
        i: int = 0
        while i < len(self._present):
            if self._present[i] == pk:
                return True
            i = i + 1
        return False

    def is_null(self: ValidatedData, k: str) -> bool:
        pk: str = self._prefix + k
        i: int = 0
        while i < len(self._nulls):
            if self._nulls[i] == pk:
                return True
            i = i + 1
        return False

    def get_str(self: ValidatedData, k: str) -> str:
        return self._strs[self._prefix + k]

    def get_opt_str(self: ValidatedData, k: str) -> str | None:
        if self.is_null(k) or not self.has(k):
            return None
        return self._strs[self._prefix + k]

    def get_int(self: ValidatedData, k: str) -> int:
        return self._ints[self._prefix + k]

    def get_opt_int(self: ValidatedData, k: str) -> int | None:
        if self.is_null(k) or not self.has(k):
            return None
        return self._ints[self._prefix + k]

    def get_float(self: ValidatedData, k: str) -> float:
        return self._floats[self._prefix + k]

    def get_opt_float(self: ValidatedData, k: str) -> float | None:
        if self.is_null(k) or not self.has(k):
            return None
        return self._floats[self._prefix + k]

    def get_bool(self: ValidatedData, k: str) -> bool:
        pk: str = self._prefix + k
        if pk in self._bools:
            return self._bools[pk]
        if pk in self._ints:
            return self._ints[pk] != 0
        return False

    def get_opt_bool(self: ValidatedData, k: str) -> bool | None:
        if self.is_null(k) or not self.has(k):
            return None
        pk: str = self._prefix + k
        if pk in self._bools:
            return self._bools[pk]
        if pk in self._ints:
            return self._ints[pk] != 0
        return None

    def get_object(self: ValidatedData, k: str) -> ValidatedData:
        sub: ValidatedData = ValidatedData()
        sub._prefix = self._prefix + k + "."
        sub._strs = self._strs
        sub._ints = self._ints
        sub._floats = self._floats
        sub._bools = self._bools
        sub._list_strs = self._list_strs
        sub._list_ints = self._list_ints
        sub._list_floats = self._list_floats
        sub._list_bools = self._list_bools
        sub._list_objs_len = self._list_objs_len
        sub._nulls = self._nulls
        sub._present = self._present
        sub._extras = self._extras
        sub._extra_keys = self._extra_keys
        return sub

    def get_opt_object(self: ValidatedData, k: str) -> ValidatedData | None:
        if self.is_null(k) or not self.has(k):
            return None
        return self.get_object(k)

    def get_list_str(self: ValidatedData, k: str) -> list[str]:
        pk: str = self._prefix + k
        if pk not in self._list_strs:
            empty: list[str] = []
            return empty
        return self._list_strs[pk]

    def get_list_int(self: ValidatedData, k: str) -> list[int]:
        pk: str = self._prefix + k
        if pk not in self._list_ints:
            empty: list[int] = []
            return empty
        return self._list_ints[pk]

    def get_list_float(self: ValidatedData, k: str) -> list[float]:
        pk: str = self._prefix + k
        if pk not in self._list_floats:
            empty: list[float] = []
            return empty
        return self._list_floats[pk]

    def get_list_bool(self: ValidatedData, k: str) -> list[bool]:
        pk: str = self._prefix + k
        if pk not in self._list_bools:
            empty: list[bool] = []
            return empty
        return self._list_bools[pk]

    def get_list_object(self: ValidatedData, k: str) -> list[ValidatedData]:
        pk: str = self._prefix + k
        res: list[ValidatedData] = []
        if pk not in self._list_objs_len:
            return res
        count: int = self._list_objs_len[pk]
        idx: int = 0
        while idx < count:
            sub: ValidatedData = ValidatedData()
            sub._prefix = pk + "[" + str(idx) + "]."
            sub._strs = self._strs
            sub._ints = self._ints
            sub._floats = self._floats
            sub._bools = self._bools
            sub._list_strs = self._list_strs
            sub._list_ints = self._list_ints
            sub._list_floats = self._list_floats
            sub._list_bools = self._list_bools
            sub._list_objs_len = self._list_objs_len
            sub._nulls = self._nulls
            sub._present = self._present
            sub._extras = self._extras
            sub._extra_keys = self._extra_keys
            res.append(sub)
            idx = idx + 1
        return res

    # ------------------------------------------------------------------
    # Typed presence introspection (used by in-memory validation, v0.8.2)
    #
    # A key can be *present* (`has`) yet stored in a container of a different
    # kind than the schema declares (e.g. an int stored under a string field).
    # These predicates let `Schema.validate_data` detect that systematically
    # instead of crashing on a dictionary lookup.
    # ------------------------------------------------------------------
    def has_str(self: ValidatedData, k: str) -> bool:
        return self.has(k) and ((self._prefix + k) in self._strs)

    def has_int(self: ValidatedData, k: str) -> bool:
        return self.has(k) and ((self._prefix + k) in self._ints)

    def has_float(self: ValidatedData, k: str) -> bool:
        return self.has(k) and ((self._prefix + k) in self._floats)

    def has_bool(self: ValidatedData, k: str) -> bool:
        return self.has(k) and ((self._prefix + k) in self._bools)

    def has_list_str(self: ValidatedData, k: str) -> bool:
        return self.has(k) and ((self._prefix + k) in self._list_strs)

    def has_list_int(self: ValidatedData, k: str) -> bool:
        return self.has(k) and ((self._prefix + k) in self._list_ints)

    def has_list_float(self: ValidatedData, k: str) -> bool:
        return self.has(k) and ((self._prefix + k) in self._list_floats)

    def has_list_bool(self: ValidatedData, k: str) -> bool:
        return self.has(k) and ((self._prefix + k) in self._list_bools)

    def has_list_object(self: ValidatedData, k: str) -> bool:
        return self.has(k) and ((self._prefix + k) in self._list_objs_len)

    # Length of the list stored under `k` regardless of element kind, or -1 when `k` holds no list.
    def list_len(self: ValidatedData, k: str) -> int:
        pk: str = self._prefix + k
        if not self.has(k):
            return -1
        if pk in self._list_strs:
            return len(self._list_strs[pk])
        if pk in self._list_ints:
            return len(self._list_ints[pk])
        if pk in self._list_floats:
            return len(self._list_floats[pk])
        if pk in self._list_bools:
            return len(self._list_bools[pk])
        if pk in self._list_objs_len:
            return self._list_objs_len[pk]
        return -1

    # True when `k` is present, non-null and not stored in any scalar/list container (i.e. a nested object).
    def has_object(self: ValidatedData, k: str) -> bool:
        if not self.has(k):
            return False
        if self.is_null(k):
            return False
        pk: str = self._prefix + k
        if pk in self._strs or pk in self._ints or pk in self._floats or pk in self._bools:
            return False
        if pk in self._list_strs or pk in self._list_ints or pk in self._list_floats or pk in self._list_bools:
            return False
        if pk in self._list_objs_len:
            return False
        return True

    # Human-readable category of what is actually stored under `k` (for type_mismatch diagnostics).
    def kind_of(self: ValidatedData, k: str) -> str:
        if not self.has(k):
            return "missing"
        if self.is_null(k):
            return "null"
        pk: str = self._prefix + k
        if pk in self._list_strs or pk in self._list_ints or pk in self._list_floats or pk in self._list_bools or pk in self._list_objs_len:
            return "array"
        if pk in self._bools:
            return "bool"
        if pk in self._floats:
            return "number"
        if pk in self._ints:
            return "number"
        if pk in self._strs:
            return "string"
        return "object"

    # Distinct first path segments of every key present under this view's prefix
    # (e.g. {"name", "addr.city", "tags", "items[0].x"} -> ["name", "addr", "tags", "items"]).
    # Used for POLICY_FORBID unknown-field detection. Declared extras (POLICY_ALLOW) are not included.
    def top_level_keys(self: ValidatedData) -> list[str]:
        res: list[str] = []
        seen: dict[str, bool] = {}
        plen: int = len(self._prefix)
        i: int = 0
        while i < len(self._present):
            pk: str = self._present[i]
            i = i + 1
            if plen > 0:
                if len(pk) <= plen:
                    continue
                if pk[0:plen] != self._prefix:
                    continue
            rem: str = pk[plen:len(pk)]
            cut: int = len(rem)
            ci: int = 0
            while ci < len(rem):
                ch: str = rem[ci:ci + 1]
                if ch == "." or ch == "[":
                    cut = ci
                    ci = len(rem)
                else:
                    ci = ci + 1
            seg: str = rem[0:cut]
            if len(seg) > 0 and seg not in seen:
                seen[seg] = True
                res.append(seg)
        return res

    def set_extra(self: ValidatedData, k: str, json_repr: str) -> None:
        pk: str = self._prefix + k
        self._extras[pk] = json_repr
        self._extra_keys.append(pk)

    def has_extra(self: ValidatedData, k: str) -> bool:
        return (self._prefix + k) in self._extras

    def get_extra(self: ValidatedData, k: str) -> str:
        pk: str = self._prefix + k
        if pk in self._extras:
            return self._extras[pk]
        return ""

    def get_extra_keys(self: ValidatedData) -> list[str]:
        if self._prefix == "":
            return self._extra_keys
        pfx_len: int = len(self._prefix)
        res: list[str] = []
        i: int = 0
        while i < len(self._extra_keys):
            ek: str = self._extra_keys[i]
            if len(ek) >= pfx_len and ek[0:pfx_len] == self._prefix:
                res.append(ek[pfx_len:len(ek)])
            i = i + 1
        return res

class ValidationResult:
    is_valid: bool
    data: ValidatedData
    errors: list[FieldError]

    def __init__(
        self: ValidationResult,
        is_valid: bool,
        data: ValidatedData,
        errors: list[FieldError]
    ) -> None:
        self.is_valid = is_valid
        self.data = data
        self.errors = errors

    def error_count(self: ValidationResult) -> int:
        return len(self.errors)

    def error_summary(self: ValidationResult) -> str:
        if len(self.errors) == 0:
            return "No errors"
        summary: str = self.errors[0].message
        if len(self.errors) > 1:
            summary = summary + " (and " + str(len(self.errors) - 1) + " more)"
        return summary

    def to_json(self: ValidationResult) -> str:
        w: JsonWriter = JsonWriter()
        w.begin_object()
        w.write_key("valid")
        w.write_bool(self.is_valid)
        w.write_key("error_count")
        w.write_int(len(self.errors))
        w.write_key("errors")
        w.begin_array()
        i: int = 0
        while i < len(self.errors):
            e: FieldError = self.errors[i]
            w.begin_object()
            w.write_key("path")
            w.write_string(e.path)
            w.write_key("code")
            w.write_string(e.code)
            w.write_key("message")
            w.write_string(e.message)
            w.write_key("expected")
            w.write_string(e.expected)
            w.write_key("actual")
            w.write_string(e.actual)
            w.end_object()
            i = i + 1
        w.end_array()
        w.end_object()
        return w.build()

class Result[T]:
    is_ok: bool
    val: T | None
    errors: list[FieldError]

    def __init__(
        self,
        is_ok: bool,
        val: T | None,
        errors: list[FieldError]
    ) -> None:
        self.is_ok = is_ok
        self.val = val
        self.errors = errors

    def unwrap(self) -> T:
        if not self.is_ok:
            raise ValidationError(self.errors)
        v: T | None = self.val
        if v is None:
            raise ValidationError(self.errors)
        return v

    def unwrap_or(self, fallback: T) -> T:
        if not self.is_ok:
            return fallback
        v: T | None = self.val
        if v is None:
            return fallback
        return v

    def errors_json(self) -> str:
        w: JsonWriter = JsonWriter()
        w.begin_object()
        w.write_key("valid")
        w.write_bool(self.is_ok)
        w.write_key("error_count")
        w.write_int(len(self.errors))
        w.write_key("errors")
        w.begin_array()
        i: int = 0
        while i < len(self.errors):
            e: FieldError = self.errors[i]
            w.begin_object()
            w.write_key("path")
            w.write_string(e.path)
            w.write_key("code")
            w.write_string(e.code)
            w.write_key("message")
            w.write_string(e.message)
            w.write_key("expected")
            w.write_string(e.expected)
            w.write_key("actual")
            w.write_string(e.actual)
            w.end_object()
            i = i + 1
        w.end_array()
        w.end_object()
        return w.build()
