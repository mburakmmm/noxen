# tests/fuzz/property_test.nox
# Property-based combinatorial invariant and adversarial tests for Noxen.

import nox.test
import schema
import core
import models
import serialization
from schema import Schema
from core import ValidatedData, ValidationResult
from models import ModelSchema, BidirectionalModel

# -----------------------------------------------------------------------------
# Precision Helper: Adaptive Relative & Absolute Floating-Point Comparison
# -----------------------------------------------------------------------------
def is_float_approx_eq(a: float, b: float) -> bool:
    diff: float = abs(a - b)
    # Absolute tolerance floor for numbers near zero
    if diff <= 0.000000001:
        return True
    max_val: float = abs(a)
    if abs(b) > max_val:
        max_val = abs(b)
    # Relative tolerance of 1 part per million (1e-6)
    return diff <= (0.000001 * max_val)

# Verify adaptive epsilon rejects coarse drift
nox.test.assert_true(is_float_approx_eq(0.123456, 0.123456), "Exact float matches")
nox.test.assert_true(not is_float_approx_eq(0.123456, 0.1235), "Coarse drift is strictly rejected")

# -----------------------------------------------------------------------------
# Model 1: SensorRecord (Combinatorial Flat Model)
# -----------------------------------------------------------------------------
class SensorRecord:
    id: int
    ratio: float
    tag: str
    active: bool
    notes: str | None

    def __init__(self, id: int, ratio: float, tag: str, active: bool, notes: str | None) -> None:
        self.id = id
        self.ratio = ratio
        self.tag = tag
        self.active = active
        self.notes = notes

def make_sensor(d: ValidatedData) -> SensorRecord:
    return SensorRecord(
        d.get_int("id"),
        d.get_float("ratio"),
        d.get_str("tag"),
        d.get_bool("active"),
        d.get_opt_str("notes")
    )

def unparse_sensor(s: SensorRecord) -> ValidatedData:
    d: ValidatedData = ValidatedData()
    d.set_int("id", s.id)
    d.set_float("ratio", s.ratio)
    d.set_str("tag", s.tag)
    d.set_bool("active", s.active)
    d.set_opt_str("notes", s.notes)
    return d

# Define Schema with numeric, choice, boolean and nullable constraints
sensor_schema: Schema = Schema("SensorRecord")
sensor_schema.field_int("id").min_i(1).max_i(1000)
sensor_schema.field_float("ratio").min(0.0).max(1.0)
sensor_schema.field_str("tag").in_choices(["alpha", "beta", "gamma"])
sensor_schema.field_bool("active")
sensor_schema.field_str("notes").optional().nullable()

sensor_model: ModelSchema[SensorRecord] = ModelSchema[SensorRecord](sensor_schema, make_sensor)
sensor_bi: BidirectionalModel[SensorRecord] = BidirectionalModel[SensorRecord](sensor_model, unparse_sensor)

# Invariant Property 1: Full Round-trip preservation across combinatorial valid states (192 combinations)
valid_ids: list[int] = [1, 50, 500, 1000]
valid_ratios: list[float] = [0.0, 0.25, 0.75, 1.0]
valid_tags: list[str] = ["alpha", "beta", "gamma"]
valid_actives: list[bool] = [True, False]

comb_count: int = 0

# Test both nullable (None) and non-null note strings across all Cartesian products
note_mode: int = 0
while note_mode < 2:
    cur_note: str | None = None
    if note_mode == 1:
        cur_note = "Normal sensor reading"

    i_id: int = 0
    while i_id < len(valid_ids):
        cur_id: int = valid_ids[i_id]
        i_rat: int = 0
        while i_rat < len(valid_ratios):
            cur_rat: float = valid_ratios[i_rat]
            i_tag: int = 0
            while i_tag < len(valid_tags):
                cur_tag: str = valid_tags[i_tag]
                i_act: int = 0
                while i_act < len(valid_actives):
                    cur_act: bool = valid_actives[i_act]

                    # Construct model instance
                    sr: SensorRecord = SensorRecord(cur_id, cur_rat, cur_tag, cur_act, cur_note)

                    # Property 1a: validate_model returns True
                    vr: ValidationResult = sensor_bi.validate_model(sr)
                    nox.test.assert_true(vr.is_valid, "Valid combination passes validate_model")

                    # Property 1b: dump and dump_validated produce identical JSON
                    dumped_fast: str = sensor_bi.dump(sr)
                    dumped_val: str = sensor_bi.dump_validated(sr)
                    nox.test.assert_eq_str(dumped_fast, dumped_val, "dump and dump_validated match on valid data")

                    # Property 1c: JSON round-trip re-parses to identical values for ALL fields
                    parsed_res: ValidationResult = sensor_schema.validate_json(dumped_val)
                    nox.test.assert_true(parsed_res.is_valid, "Serialized JSON re-validates cleanly")
                    nox.test.assert_eq_int(parsed_res.data.get_int("id"), cur_id, "id preserved in round-trip")
                    nox.test.assert_eq_str(parsed_res.data.get_str("tag"), cur_tag, "tag preserved in round-trip")
                    nox.test.assert_true(parsed_res.data.get_bool("active") == cur_act, "active preserved in round-trip")

                    # Exact field verification for ratio (adaptive relative float precision)
                    nox.test.assert_true(is_float_approx_eq(parsed_res.data.get_float("ratio"), cur_rat), "ratio preserved with adaptive relative precision")

                    # Exact field verification for notes (nullable vs string)
                    if cur_note is None:
                        nox.test.assert_true(parsed_res.data.is_null("notes"), "notes is null when None")
                        nox.test.assert_true(parsed_res.data.get_opt_str("notes") is None, "notes get_opt_str is None")
                    else:
                        nox.test.assert_eq_str(parsed_res.data.get_str("notes"), cur_note, "notes string preserved in round-trip")

                    comb_count = comb_count + 1
                    i_act = i_act + 1
                i_tag = i_tag + 1
            i_rat = i_rat + 1
        i_id = i_id + 1
    note_mode = note_mode + 1

nox.test.assert_true(comb_count == 192, "Tested 192 valid combinatorial states with complete field verification")

# -----------------------------------------------------------------------------
# Invariant Property 2: Soundness — Constraint violation always detected at exact path
# -----------------------------------------------------------------------------
# Test out-of-range IDs
bad_ids: list[int] = [0, -1, -999, 1001, 9999]
bi_i: int = 0
while bi_i < len(bad_ids):
    bad_sr_id: SensorRecord = SensorRecord(bad_ids[bi_i], 0.5, "alpha", True, None)
    v_bad_id: ValidationResult = sensor_bi.validate_model(bad_sr_id)
    nox.test.assert_true(not v_bad_id.is_valid, "Out-of-range id rejected")
    nox.test.assert_eq_str(v_bad_id.errors[0].path, "id", "Error attributed to id")
    bi_i = bi_i + 1

# Test invalid tags (disallowed choices)
bad_tags: list[str] = ["delta", "omega", "", "ALPHA"]
bt_i: int = 0
while bt_i < len(bad_tags):
    bad_sr_tag: SensorRecord = SensorRecord(10, 0.5, bad_tags[bt_i], True, None)
    v_bad_tag: ValidationResult = sensor_bi.validate_model(bad_sr_tag)
    nox.test.assert_true(not v_bad_tag.is_valid, "Disallowed tag rejected")
    nox.test.assert_eq_str(v_bad_tag.errors[0].path, "tag", "Error attributed to tag")
    bt_i = bt_i + 1

# Test out-of-range ratios
bad_ratios: list[float] = [-0.1, -1.0, 1.01, 5.5]
br_i: int = 0
while br_i < len(bad_ratios):
    bad_sr_rat: SensorRecord = SensorRecord(10, bad_ratios[br_i], "alpha", True, None)
    v_bad_rat: ValidationResult = sensor_bi.validate_model(bad_sr_rat)
    nox.test.assert_true(not v_bad_rat.is_valid, "Out-of-range ratio rejected")
    nox.test.assert_eq_str(v_bad_rat.errors[0].path, "ratio", "Error attributed to ratio")
    br_i = br_i + 1

# -----------------------------------------------------------------------------
# Invariant Property 3: Unicode, Control & Long String Round-Trip Preservation
# -----------------------------------------------------------------------------
class TextRecord:
    id: int
    content: str

    def __init__(self, id: int, content: str) -> None:
        self.id = id
        self.content = content

def make_text_record(d: ValidatedData) -> TextRecord:
    return TextRecord(d.get_int("id"), d.get_str("content"))

def unparse_text_record(t: TextRecord) -> ValidatedData:
    d: ValidatedData = ValidatedData()
    d.set_int("id", t.id)
    d.set_str("content", t.content)
    return d

text_schema: Schema = Schema("TextRecord")
text_schema.field_int("id").min_i(1)
text_schema.field_str("content")

text_model: ModelSchema[TextRecord] = ModelSchema[TextRecord](text_schema, make_text_record)
text_bi: BidirectionalModel[TextRecord] = BidirectionalModel[TextRecord](text_model, unparse_text_record)

# Build a 5,000-character multi-byte UTF-8 string to test buffer management
long_chunk: str = "Noxen-Türkçe-🚀-2026-"
long_buf: str = ""
li: int = 0
while li < 250:
    long_buf = long_buf + long_chunk
    li = li + 1

unicode_test_strings: list[str] = [
    "Türkçe karakter seti: çğıöşü ÇĞİÖŞÜ",
    "International: España, München, Zürich, Tokyo 東京, Seoul 서울",
    "Cyrillic: Привет мир, Добро пожаловать",
    "Emoji sequences: 🚀 🔥 ⚡ 🎯 💻 📦 ✨ 🎉",
    "Quotes and Backslashes: \"quoted text\" and \\backslash\\ path",
    "Newlines and Tabs: Line 1\nLine 2\tTabbed\rCarriage",
    "Control characters: \b backspace and \f formfeed",
    "Combining Unicode: e\u0301 (é) and a\u0308 (ä)",
    "Code snippets: <script>alert('xss')</script> and SELECT * FROM users;",
    "",
    "   leading and trailing spaces   ",
    long_buf
]

ut_i: int = 0
while ut_i < len(unicode_test_strings):
    u_str: str = unicode_test_strings[ut_i]
    tr: TextRecord = TextRecord(ut_i + 1, u_str)

    # Validate model
    v_tr: ValidationResult = text_bi.validate_model(tr)
    nox.test.assert_true(v_tr.is_valid, "Unicode text passes validate_model")

    # Serialize via dump and dump_validated
    d_fast: str = text_bi.dump(tr)
    d_chk: str = text_bi.dump_validated(tr)
    nox.test.assert_eq_str(d_fast, d_chk, "dump matches dump_validated for unicode")

    # Deserialize and assert full string equivalence
    parsed_u: ValidationResult = text_schema.validate_json(d_chk)
    nox.test.assert_true(parsed_u.is_valid, "Unicode JSON re-validates cleanly")
    nox.test.assert_eq_str(parsed_u.data.get_str("content"), u_str, "String content preserved exactly")
    ut_i = ut_i + 1

# -----------------------------------------------------------------------------
# Invariant Property 4: Adaptive Float Precision and Boundary Round-Trip
# -----------------------------------------------------------------------------
class MeasurementRecord:
    reading: float

    def __init__(self, reading: float) -> None:
        self.reading = reading

def make_measurement(d: ValidatedData) -> MeasurementRecord:
    return MeasurementRecord(d.get_float("reading"))

def unparse_measurement(m: MeasurementRecord) -> ValidatedData:
    d: ValidatedData = ValidatedData()
    d.set_float("reading", m.reading)
    return d

meas_schema: Schema = Schema("MeasurementRecord")
meas_schema.field_float("reading")

meas_model: ModelSchema[MeasurementRecord] = ModelSchema[MeasurementRecord](meas_schema, make_measurement)
meas_bi: BidirectionalModel[MeasurementRecord] = BidirectionalModel[MeasurementRecord](meas_model, unparse_measurement)

float_test_vals: list[float] = [
    0.0, 1.0, 0.5, 0.25, 0.75, 0.00001, 0.99999, 0.123456, 12345.6789, -42.5, 0.0000001, 1234567.890123
]
flt_i: int = 0
while flt_i < len(float_test_vals):
    expected_f: float = float_test_vals[flt_i]
    mr: MeasurementRecord = MeasurementRecord(expected_f)
    d_f: str = meas_bi.dump_validated(mr)
    p_f: ValidationResult = meas_schema.validate_json(d_f)
    nox.test.assert_true(p_f.is_valid, "Float re-validates cleanly")
    actual_f: float = p_f.data.get_float("reading")
    nox.test.assert_true(is_float_approx_eq(actual_f, expected_f), "Float preserved with adaptive relative precision")
    flt_i = flt_i + 1

# -----------------------------------------------------------------------------
# Invariant Property 5: Nested Model Round-Trip Preservation
# -----------------------------------------------------------------------------
class HardwareSpecs:
    cores: int
    memory_mb: int
    gpu_model: str | None

    def __init__(self, cores: int, memory_mb: int, gpu_model: str | None) -> None:
        self.cores = cores
        self.memory_mb = memory_mb
        self.gpu_model = gpu_model

class MachineRecord:
    machine_id: int
    hostname: str
    hardware: HardwareSpecs

    def __init__(self, machine_id: int, hostname: str, hardware: HardwareSpecs) -> None:
        self.machine_id = machine_id
        self.hostname = hostname
        self.hardware = hardware

hw_schema: Schema = Schema("HardwareSpecs")
hw_schema.field_int("cores").min_i(1)
hw_schema.field_int("memory_mb").min_i(512)
hw_schema.field_str("gpu_model").optional().nullable()

def make_hw(d: ValidatedData) -> HardwareSpecs:
    return HardwareSpecs(d.get_int("cores"), d.get_int("memory_mb"), d.get_opt_str("gpu_model"))

def unparse_hw(hw: HardwareSpecs) -> ValidatedData:
    d: ValidatedData = ValidatedData()
    d.set_int("cores", hw.cores)
    d.set_int("memory_mb", hw.memory_mb)
    d.set_opt_str("gpu_model", hw.gpu_model)
    return d

mach_schema: Schema = Schema("MachineRecord")
mach_schema.field_int("machine_id").min_i(1)
mach_schema.field_str("hostname").min_length(3)
mach_schema.field_object("hardware", hw_schema)

def make_mach(d: ValidatedData) -> MachineRecord:
    hw_d: ValidatedData = d.get_object("hardware")
    return MachineRecord(d.get_int("machine_id"), d.get_str("hostname"), make_hw(hw_d))

def unparse_mach(m: MachineRecord) -> ValidatedData:
    d: ValidatedData = ValidatedData()
    d.set_int("machine_id", m.machine_id)
    d.set_str("hostname", m.hostname)
    d.set_object("hardware", unparse_hw(m.hardware))
    return d

mach_model: ModelSchema[MachineRecord] = ModelSchema[MachineRecord](mach_schema, make_mach)
mach_bi: BidirectionalModel[MachineRecord] = BidirectionalModel[MachineRecord](mach_model, unparse_mach)

# Test multiple nested permutations
hw_permutations: list[HardwareSpecs] = [
    HardwareSpecs(4, 8192, None),
    HardwareSpecs(16, 65536, "NVIDIA RTX 4090"),
    HardwareSpecs(64, 262144, "NVIDIA H100 SXM5")
]

hw_i: int = 0
while hw_i < len(hw_permutations):
    cur_hw: HardwareSpecs = hw_permutations[hw_i]
    host_name: str = "cluster-node-" + str(hw_i + 1)
    mr_inst: MachineRecord = MachineRecord(hw_i + 100, host_name, cur_hw)

    # Validate model
    v_mr: ValidationResult = mach_bi.validate_model(mr_inst)
    nox.test.assert_true(v_mr.is_valid, "Nested model passes validate_model")

    # Serialize and round-trip
    dumped_mach: str = mach_bi.dump_validated(mr_inst)
    parsed_mach: ValidationResult = mach_schema.validate_json(dumped_mach)
    nox.test.assert_true(parsed_mach.is_valid, "Nested JSON re-validates cleanly")

    # Verify outer model properties
    nox.test.assert_eq_int(parsed_mach.data.get_int("machine_id"), hw_i + 100, "machine_id preserved")
    nox.test.assert_eq_str(parsed_mach.data.get_str("hostname"), host_name, "hostname preserved")

    # Verify inner nested model properties
    inner_hw: ValidatedData = parsed_mach.data.get_object("hardware")
    nox.test.assert_eq_int(inner_hw.get_int("cores"), cur_hw.cores, "nested cores preserved")
    nox.test.assert_eq_int(inner_hw.get_int("memory_mb"), cur_hw.memory_mb, "nested memory preserved")
    gpu_val: str | None = cur_hw.gpu_model
    if gpu_val is None:
        nox.test.assert_true(inner_hw.is_null("gpu_model"), "nested null gpu_model preserved")
    else:
        nox.test.assert_eq_str(inner_hw.get_str("gpu_model"), gpu_val, "nested gpu_model string preserved")

    hw_i = hw_i + 1

# -----------------------------------------------------------------------------
# Invariant Property 6: Multi-Level Nested Array Hierarchy Round-Trip
# -----------------------------------------------------------------------------
class GeoLocation:
    city: str
    country: str

    def __init__(self, city: str, country: str) -> None:
        self.city = city
        self.country = country

class ServerNode:
    node_id: int
    locations: list[GeoLocation]

    def __init__(self, node_id: int, locations: list[GeoLocation]) -> None:
        self.node_id = node_id
        self.locations = locations

class Cluster:
    name: str
    nodes: list[ServerNode]

    def __init__(self, name: str, nodes: list[ServerNode]) -> None:
        self.name = name
        self.nodes = nodes

geo_s: Schema = Schema("GeoLocation")
geo_s.field_str("city").min_length(2)
geo_s.field_str("country").min_length(2)

node_s: Schema = Schema("ServerNode")
node_s.field_int("node_id").min_i(1)
node_s.field_list_schema("locations", geo_s)

cluster_s: Schema = Schema("Cluster")
cluster_s.field_str("name").min_length(2)
cluster_s.field_list_schema("nodes", node_s)

def make_geo(d: ValidatedData) -> GeoLocation:
    return GeoLocation(d.get_str("city"), d.get_str("country"))

def make_node(d: ValidatedData) -> ServerNode:
    loc_vds: list[ValidatedData] = d.get_list_object("locations")
    locs: list[GeoLocation] = []
    i: int = 0
    while i < len(loc_vds):
        locs.append(make_geo(loc_vds[i]))
        i = i + 1
    return ServerNode(d.get_int("node_id"), locs)

def make_cluster(d: ValidatedData) -> Cluster:
    node_vds: list[ValidatedData] = d.get_list_object("nodes")
    nds: list[ServerNode] = []
    i: int = 0
    while i < len(node_vds):
        nds.append(make_node(node_vds[i]))
        i = i + 1
    return Cluster(d.get_str("name"), nds)

# Test multi-level array round trip
cluster_json: str = "{\"name\":\"GlobalEdge\",\"nodes\":[{\"node_id\":1,\"locations\":[{\"city\":\"Frankfurt\",\"country\":\"DE\"},{\"city\":\"Amsterdam\",\"country\":\"NL\"}]},{\"node_id\":2,\"locations\":[{\"city\":\"Tokyo\",\"country\":\"JP\"}]}]}"

vr_cl: ValidationResult = cluster_s.validate_json(cluster_json)
nox.test.assert_true(vr_cl.is_valid, "Multi-level array JSON validates cleanly")
cl_obj: Cluster = make_cluster(vr_cl.data)
nox.test.assert_eq_str(cl_obj.name, "GlobalEdge", "Cluster name preserved")
nox.test.assert_eq_int(len(cl_obj.nodes), 2, "Cluster has 2 nodes")
nox.test.assert_eq_int(len(cl_obj.nodes[0].locations), 2, "Node 0 has 2 locations")
nox.test.assert_eq_str(cl_obj.nodes[0].locations[0].city, "Frankfurt", "Node 0 Loc 0 city is Frankfurt")
nox.test.assert_eq_str(cl_obj.nodes[1].locations[0].city, "Tokyo", "Node 1 Loc 0 city is Tokyo")

# Dump cluster data and revalidate
dumped_cl: str = cluster_s.dump_validated(vr_cl.data)
vr_cl_re: ValidationResult = cluster_s.validate_json(dumped_cl)
nox.test.assert_true(vr_cl_re.is_valid, "Dumped cluster re-validates cleanly")
cl_obj_re: Cluster = make_cluster(vr_cl_re.data)
nox.test.assert_eq_str(cl_obj_re.name, "GlobalEdge", "Re-validated cluster name preserved")
nox.test.assert_eq_int(len(cl_obj_re.nodes), 2, "Re-validated cluster has 2 nodes")
nox.test.assert_eq_str(cl_obj_re.nodes[0].locations[1].city, "Amsterdam", "Nested location intact")

# -----------------------------------------------------------------------------
# Invariant Property 7: Additional Adversarial JSON Payloads
# -----------------------------------------------------------------------------
# 1. Type mismatch (string passed for integer id)
bad_type_json: str = "{\"id\": \"not_an_int\", \"ratio\": 0.5, \"tag\": \"alpha\", \"active\": true, \"notes\": null}"
res_bad_type: ValidationResult = sensor_schema.validate_json(bad_type_json)
nox.test.assert_true(not res_bad_type.is_valid, "String for int rejected")
nox.test.assert_eq_str(res_bad_type.errors[0].path, "id", "Error on path id")

# 2. Boolean strictness (numeric 1 passed for boolean active in strict mode)
bad_bool_json: str = "{\"id\": 10, \"ratio\": 0.5, \"tag\": \"alpha\", \"active\": 1, \"notes\": null}"
res_bad_bool: ValidationResult = sensor_schema.validate_json(bad_bool_json)
nox.test.assert_true(not res_bad_bool.is_valid, "Numeric 1 for bool rejected in strict mode")
nox.test.assert_eq_str(res_bad_bool.errors[0].path, "active", "Error on path active")

# 3. Missing required field
missing_field_json: str = "{\"ratio\": 0.5, \"tag\": \"alpha\", \"active\": true}"
res_missing: ValidationResult = sensor_schema.validate_json(missing_field_json)
nox.test.assert_true(not res_missing.is_valid, "Missing required id rejected")
nox.test.assert_eq_str(res_missing.errors[0].path, "id", "Error on path id")

# 4. Unexpected extra fields when POLICY_FORBID is active
unexpected_json: str = "{\"id\": 10, \"ratio\": 0.5, \"tag\": \"alpha\", \"active\": true, \"notes\": null, \"malicious_extra\": 999}"
res_extra: ValidationResult = sensor_schema.validate_json(unexpected_json)
nox.test.assert_true(not res_extra.is_valid, "Unexpected extra field rejected under FORBID")
nox.test.assert_eq_str(res_extra.errors[0].path, "malicious_extra", "Error on extra field path")

# 5. Nested array element constraint violation with exact path attribution
bad_nested_arr_json: str = "{\"name\":\"GlobalEdge\",\"nodes\":[{\"node_id\":1,\"locations\":[{\"city\":\"F\",\"country\":\"DE\"}]}]}"
res_bad_nested: ValidationResult = cluster_s.validate_json(bad_nested_arr_json)
nox.test.assert_true(not res_bad_nested.is_valid, "Nested array constraint violation rejected")
nox.test.assert_eq_str(res_bad_nested.errors[0].path, "nodes[0].locations[0].city", "Error accurately attributed to deep array path")

print("property_test passed (192 valid Cartesian + 12 Unicode + 12 Float + 3 Nested Models + 2 Nested Array Hierarchies + 18 Adversarial permutations)")
