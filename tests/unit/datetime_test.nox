# tests/unit/datetime_test.nox
# Verifies ISO 8601 date, time, and datetime validation rules and error codes.

import nox.test
import schema
import core
import errors
from schema import Schema
from core import ValidationResult
from errors import CODE_INVALID_DATE, CODE_INVALID_TIME, CODE_INVALID_DATETIME

s: Schema = Schema("Event")
s.field_str("event_date").date()
s.field_str("start_time").time()
s.field_str("created_at").datetime()

# 1. Valid payload
ok_json: str = "{\"event_date\":\"2026-10-26\",\"start_time\":\"14:30:00Z\",\"created_at\":\"2026-10-26T14:30:00+03:00\"}"
res_ok: ValidationResult = s.validate_json(ok_json)
nox.test.assert_true(res_ok.is_valid, "valid dates and times pass")
nox.test.assert_eq_str(res_ok.data.get_str("event_date"), "2026-10-26", "date stored")
nox.test.assert_eq_str(res_ok.data.get_str("start_time"), "14:30:00Z", "time stored")

# 2. Invalid date (leap year check: 2026 is not a leap year)
bad_date_json: str = "{\"event_date\":\"2026-02-29\",\"start_time\":\"14:30:00\",\"created_at\":\"2026-10-26T14:30:00Z\"}"
res_bad_date: ValidationResult = s.validate_json(bad_date_json)
nox.test.assert_true(not res_bad_date.is_valid, "invalid leap date fails")
nox.test.assert_eq_str(res_bad_date.errors[0].code, CODE_INVALID_DATE, "code is invalid_date")

# 3. Invalid time (hour 25 is out of range)
bad_time_json: str = "{\"event_date\":\"2024-02-29\",\"start_time\":\"25:00:00\",\"created_at\":\"2026-10-26T14:30:00Z\"}"
res_bad_time: ValidationResult = s.validate_json(bad_time_json)
nox.test.assert_true(not res_bad_time.is_valid, "invalid time fails")
nox.test.assert_eq_str(res_bad_time.errors[0].code, CODE_INVALID_TIME, "code is invalid_time")

# 4. Invalid datetime (malformed separator)
bad_dt_json: str = "{\"event_date\":\"2024-02-29\",\"start_time\":\"14:30:00\",\"created_at\":\"2026-10-26_14:30:00\"}"
res_bad_dt: ValidationResult = s.validate_json(bad_dt_json)
nox.test.assert_true(not res_bad_dt.is_valid, "invalid datetime separator fails")
nox.test.assert_eq_str(res_bad_dt.errors[0].code, CODE_INVALID_DATETIME, "code is invalid_datetime")

print("datetime_test passed")
