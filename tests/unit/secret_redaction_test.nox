# tests/unit/secret_redaction_test.nox
# Verifies that sensitive fields marked with .secret() are masked as [REDACTED] in error reports.

import nox.test
import schema
import core
from schema import Schema
from core import ValidationResult

s: Schema = Schema("Credentials")
s.field_str("username").min_length(3)
s.field_str("password").min_length(8).secret()
s.field_str("api_token").secret().regex("^[0-9]+$")

# 1. Valid payload
ok_json: str = "{\"username\":\"alice\",\"password\":\"validPassword123\",\"api_token\":\"987654321\"}"
res_ok: ValidationResult = s.validate_json(ok_json)
nox.test.assert_true(res_ok.is_valid, "valid credentials pass")

# 2. Invalid api_token (fails regex)
bad_token_json: str = "{\"username\":\"alice\",\"password\":\"validPassword123\",\"api_token\":\"super_secret_raw_token_xyz\"}"
res_token: ValidationResult = s.validate_json(bad_token_json)
nox.test.assert_true(not res_token.is_valid, "invalid token fails")
nox.test.assert_eq_str(res_token.errors[0].actual, "[REDACTED]", "raw secret is redacted from error actual value")
nox.test.assert_true(res_token.errors[0].actual != "super_secret_raw_token_xyz", "raw secret is never leaked")

print("secret_redaction_test passed")
