# models.nox — Typed model binding and generic parser for Noxen.

import schema
import core
import errors
import nox.db
import nox.json
from schema import Schema, auto_schema
from core import ValidatedData, ValidationResult, Result
from errors import FieldError
from nox.db import Row
from nox.json import JsonValue

class ModelSchema[T]:
    schema: Schema
    factory: (ValidatedData) -> T

    def __init__(self, schema: Schema, factory: (ValidatedData) -> T) -> None:
        self.schema = schema
        self.factory = factory

    def validate(self, v: JsonValue) -> ValidationResult:
        return self.schema.validate(v)

    def validate_json(self, json_str: str) -> ValidationResult:
        return self.schema.validate_json(json_str)

    def validate_row(self, row: Row) -> ValidationResult:
        return self.schema.validate_row(row)

    def parse(self, v: JsonValue) -> Result[T]:
        res: ValidationResult = self.schema.validate(v)
        if not res.is_valid:
            return Result[T](False, None, res.errors)
        f: (ValidatedData) -> T = self.factory
        obj: T = f(res.data)
        empty_errs: list[FieldError] = []
        return Result[T](True, obj, empty_errs)

    def parse_json(self, json_str: str) -> Result[T]:
        res: ValidationResult = self.schema.validate_json(json_str)
        if not res.is_valid:
            return Result[T](False, None, res.errors)
        f: (ValidatedData) -> T = self.factory
        obj: T = f(res.data)
        empty_errs: list[FieldError] = []
        return Result[T](True, obj, empty_errs)

    def parse_row(self, row: Row) -> Result[T]:
        res: ValidationResult = self.schema.validate_row(row)
        if not res.is_valid:
            return Result[T](False, None, res.errors)
        f: (ValidatedData) -> T = self.factory
        obj: T = f(res.data)
        empty_errs: list[FieldError] = []
        return Result[T](True, obj, empty_errs)

    def dump(self, data: ValidatedData) -> str:
        return self.schema.dump(data)

    def dump_data(self, data: ValidatedData) -> str:
        return self.schema.dump(data)

    def dump_model(self, obj: T, unparser: (T) -> ValidatedData) -> str:
        d: ValidatedData = unparser(obj)
        return self.schema.dump(d)

    def to_json(self, obj: T, unparser: (T) -> ValidatedData) -> str:
        d: ValidatedData = unparser(obj)
        return self.schema.dump(d)

    def dump_validated(self, data: ValidatedData) -> str:
        return self.schema.dump_validated(data)

    def dump_model_validated(self, obj: T, unparser: (T) -> ValidatedData) -> str:
        d: ValidatedData = unparser(obj)
        return self.schema.dump_validated(d)

    def to_json_validated(self, obj: T, unparser: (T) -> ValidatedData) -> str:
        d: ValidatedData = unparser(obj)
        return self.schema.dump_validated(d)

class BidirectionalModel[T]:
    model: ModelSchema[T]
    unparser: (T) -> ValidatedData

    def __init__(self, model: ModelSchema[T], unparser: (T) -> ValidatedData) -> None:
        self.model = model
        self.unparser = unparser

    def validate(self, v: JsonValue) -> ValidationResult:
        return self.model.validate(v)

    def validate_json(self, json_str: str) -> ValidationResult:
        return self.model.validate_json(json_str)

    def validate_row(self, row: Row) -> ValidationResult:
        return self.model.validate_row(row)

    def validate_model(self, obj: T) -> ValidationResult:
        u: (T) -> ValidatedData = self.unparser
        d: ValidatedData = u(obj)
        raw_json: str = self.model.schema.dump(d)
        return self.model.schema.validate_json(raw_json)

    def parse(self, v: JsonValue) -> Result[T]:
        return self.model.parse(v)

    def parse_json(self, json_str: str) -> Result[T]:
        return self.model.parse_json(json_str)

    def parse_row(self, row: Row) -> Result[T]:
        return self.model.parse_row(row)

    def dump_data(self, data: ValidatedData) -> str:
        return self.model.dump(data)

    def dump(self, obj: T) -> str:
        u: (T) -> ValidatedData = self.unparser
        d: ValidatedData = u(obj)
        return self.model.schema.dump(d)

    def dump_validated(self, obj: T) -> str:
        u: (T) -> ValidatedData = self.unparser
        d: ValidatedData = u(obj)
        return self.model.schema.dump_validated(d)

    def to_json(self, obj: T) -> str:
        return self.dump(obj)

    def to_json_validated(self, obj: T) -> str:
        return self.dump_validated(obj)

    def to_json_schema(self) -> str:
        return self.model.schema.to_json_schema()

class Model:
    schema: Schema
    data: ValidatedData

    def __init__(self: Model, schema: Schema, data: ValidatedData | None = None) -> None:
        self.schema = schema
        if data is None:
            self.data = ValidatedData()
        else:
            self.data = data

    def validate(self: Model, v: JsonValue) -> ValidationResult:
        return self.schema.validate(v)

    def validate_json(self: Model, json_str: str) -> ValidationResult:
        return self.schema.validate_json(json_str)

    def validate_row(self: Model, row: Row) -> ValidationResult:
        return self.schema.validate_row(row)

    # Validates current in-memory model data against schema
    def validate_current(self: Model) -> ValidationResult:
        raw_json: str = self.schema.dump(self.data)
        return self.schema.validate_json(raw_json)

    # Returns true if current in-memory model data satisfies all schema constraints
    def is_valid(self: Model) -> bool:
        res: ValidationResult = self.validate_current()
        return res.is_valid

    # Parses and validates JSON. On failure, preserves existing valid state (never leaves model in partially mutated state).
    def parse_json(self: Model, json_str: str) -> ValidationResult:
        res: ValidationResult = self.schema.validate_json(json_str)
        if res.is_valid:
            self.data = res.data
        return res

    # Parses and validates tabular row. On failure, preserves existing valid state.
    def parse_row(self: Model, row: Row) -> ValidationResult:
        res: ValidationResult = self.schema.validate_row(row)
        if res.is_valid:
            self.data = res.data
        return res

    def dump(self: Model) -> str:
        return self.schema.dump(self.data)

    def to_json(self: Model) -> str:
        return self.schema.dump(self.data)

    def dump_validated(self: Model) -> str:
        return self.schema.dump_validated(self.data)

    def to_json_validated(self: Model) -> str:
        return self.schema.dump_validated(self.data)

    def to_json_schema(self: Model) -> str:
        return self.schema.to_json_schema()

    # Fluent data getters
    def get_str(self: Model, key: str) -> str:
        return self.data.get_str(key)

    def get_int(self: Model, key: str) -> int:
        return self.data.get_int(key)

    def get_float(self: Model, key: str) -> float:
        return self.data.get_float(key)

    def get_bool(self: Model, key: str) -> bool:
        return self.data.get_bool(key)

    def get_opt_str(self: Model, key: str) -> str | None:
        return self.data.get_opt_str(key)

    def get_opt_int(self: Model, key: str) -> int | None:
        return self.data.get_opt_int(key)

    def get_opt_float(self: Model, key: str) -> float | None:
        return self.data.get_opt_float(key)

    def get_opt_bool(self: Model, key: str) -> bool | None:
        return self.data.get_opt_bool(key)

    def get_list_str(self: Model, key: str) -> list[str]:
        return self.data.get_list_str(key)

    def get_list_int(self: Model, key: str) -> list[int]:
        return self.data.get_list_int(key)

    def get_list_float(self: Model, key: str) -> list[float]:
        return self.data.get_list_float(key)

    def get_list_bool(self: Model, key: str) -> list[bool]:
        return self.data.get_list_bool(key)

    def get_object(self: Model, key: str) -> ValidatedData:
        return self.data.get_object(key)

    def get_opt_object(self: Model, key: str) -> ValidatedData | None:
        return self.data.get_opt_object(key)

    def get_list_object(self: Model, key: str) -> list[ValidatedData]:
        return self.data.get_list_object(key)

    # Fluent data setters
    def set_str(self: Model, key: str, val: str) -> Model:
        self.data.set_str(key, val)
        return self

    def set_int(self: Model, key: str, val: int) -> Model:
        self.data.set_int(key, val)
        return self

    def set_float(self: Model, key: str, val: float) -> Model:
        self.data.set_float(key, val)
        return self

    def set_bool(self: Model, key: str, val: bool) -> Model:
        self.data.set_bool(key, val)
        return self

    def set_opt_str(self: Model, key: str, val: str | None) -> Model:
        self.data.set_opt_str(key, val)
        return self

    def set_opt_int(self: Model, key: str, val: int | None) -> Model:
        self.data.set_opt_int(key, val)
        return self

    def set_opt_float(self: Model, key: str, val: float | None) -> Model:
        self.data.set_opt_float(key, val)
        return self

    def set_opt_bool(self: Model, key: str, val: bool | None) -> Model:
        self.data.set_opt_bool(key, val)
        return self

    def has(self: Model, key: str) -> bool:
        return self.data.has(key)

    def is_null(self: Model, key: str) -> bool:
        return self.data.is_null(key)

def auto_model(class_name: str) -> Model:
    s: Schema = auto_schema(class_name)
    return Model(s)
