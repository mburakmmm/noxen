# serialization.nox — Controlled model serialization to JSON.

import nox.json
from nox.json import JsonWriter, JsonValue
import core
from core import ValidatedData

def is_finite_float(v: float) -> bool:
    # Pure mathematical IEEE 754 finite check without division-by-zero or string formatting:
    # 1. NaN != NaN (v == v is False for NaN)
    # 2. (+-inf - +-inf) is NaN != 0.0
    return (v == v) and ((v - v) == 0.0)

class Serializer:
    _w: JsonWriter
    _written_map: dict[str, bool]
    _strict_keys: bool

    def __init__(self: Serializer, strict_keys: bool = True) -> None:
        self._w = JsonWriter()
        self._written_map = {}
        self._strict_keys = strict_keys
        self._w.begin_object()

    def strict(self: Serializer) -> Serializer:
        self._strict_keys = True
        return self

    def lax(self: Serializer) -> Serializer:
        self._strict_keys = False
        return self

    def set_strict_keys(self: Serializer, strict: bool) -> None:
        self._strict_keys = strict

    def is_strict_keys(self: Serializer) -> bool:
        return self._strict_keys

    def _record_key(self: Serializer, k: str) -> None:
        if self._strict_keys and (k in self._written_map):
            raise ValueError("Duplicate JSON key '" + k + "' written to Serializer")
        self._written_map[k] = True

    def has_written_key(self: Serializer, k: str) -> bool:
        return k in self._written_map

    def str(self: Serializer, k: str, v: str) -> None:
        self._record_key(k)
        self._w.write_key(k)
        self._w.write_string(v)

    def int(self: Serializer, k: str, v: int) -> None:
        self._record_key(k)
        self._w.write_key(k)
        self._w.write_int(v)

    def float(self: Serializer, k: str, v: float) -> None:
        # Validate mathematical finiteness BEFORE mutating internal serializer state
        if not is_finite_float(v):
            raise ValueError("Cannot serialize non-finite float (" + str(v) + ") for key '" + k + "' to JSON")
        self._record_key(k)
        self._w.write_key(k)
        self._w.write_float(v)

    def bool(self: Serializer, k: str, v: bool) -> None:
        self._record_key(k)
        self._w.write_key(k)
        self._w.write_bool(v)

    def null(self: Serializer, k: str) -> None:
        self._record_key(k)
        self._w.write_key(k)
        self._w.write_null()

    def opt_str(self: Serializer, k: str, v: str | None) -> None:
        self._record_key(k)
        self._w.write_key(k)
        if v is None:
            self._w.write_null()
        else:
            self._w.write_string(v)

    def opt_int(self: Serializer, k: str, v: int | None) -> None:
        self._record_key(k)
        self._w.write_key(k)
        if v is None:
            self._w.write_null()
        else:
            self._w.write_int(v)

    def opt_float(self: Serializer, k: str, v: float | None) -> None:
        # Validate mathematical finiteness BEFORE mutating internal serializer state
        if v is not None:
            if not is_finite_float(v):
                raise ValueError("Cannot serialize non-finite float (" + str(v) + ") for key '" + k + "' to JSON")
        self._record_key(k)
        self._w.write_key(k)
        if v is None:
            self._w.write_null()
        else:
            self._w.write_float(v)

    def opt_bool(self: Serializer, k: str, v: bool | None) -> None:
        self._record_key(k)
        self._w.write_key(k)
        if v is None:
            self._w.write_null()
        else:
            self._w.write_bool(v)

    def list_str(self: Serializer, k: str, items: list[str]) -> None:
        self._record_key(k)
        self._w.write_key(k)
        self._w.begin_array()
        i: int = 0
        while i < len(items):
            self._w.write_string(items[i])
            i = i + 1
        self._w.end_array()

    def list_int(self: Serializer, k: str, items: list[int]) -> None:
        self._record_key(k)
        self._w.write_key(k)
        self._w.begin_array()
        i: int = 0
        while i < len(items):
            self._w.write_int(items[i])
            i = i + 1
        self._w.end_array()

    def list_float(self: Serializer, k: str, items: list[float]) -> None:
        # Validate ALL items first BEFORE mutating internal serializer state
        i: int = 0
        while i < len(items):
            if not is_finite_float(items[i]):
                raise ValueError("Cannot serialize non-finite float (" + str(items[i]) + ") in array for key '" + k + "' to JSON")
            i = i + 1
        self._record_key(k)
        self._w.write_key(k)
        self._w.begin_array()
        i = 0
        while i < len(items):
            self._w.write_float(items[i])
            i = i + 1
        self._w.end_array()

    def list_bool(self: Serializer, k: str, items: list[bool]) -> None:
        self._record_key(k)
        self._w.write_key(k)
        self._w.begin_array()
        i: int = 0
        while i < len(items):
            self._w.write_bool(items[i])
            i = i + 1
        self._w.end_array()

    def raw_json(self: Serializer, k: str, json_text: str) -> None:
        # Parse first to guarantee valid JSON BEFORE mutating internal serializer state
        v: JsonValue = nox.json.parse(json_text)
        self._record_key(k)
        self._w.write_key(k)
        self._w.write_value(v)

    def opt_raw_json(self: Serializer, k: str, json_text: str | None) -> None:
        # Parse first if not None BEFORE mutating internal serializer state
        if json_text is None:
            self._record_key(k)
            self._w.write_key(k)
            self._w.write_null()
        else:
            v: JsonValue = nox.json.parse(json_text)
            self._record_key(k)
            self._w.write_key(k)
            self._w.write_value(v)

    def include_extras(self: Serializer, data: ValidatedData) -> None:
        keys: list[str] = data.get_extra_keys()
        i: int = 0
        while i < len(keys):
            k: str = keys[i]
            if not self.has_written_key(k):
                v_json: str = data.get_extra(k)
                self.raw_json(k, v_json)
            i = i + 1

    def build(self: Serializer) -> str:
        self._w.end_object()
        return self._w.build()

