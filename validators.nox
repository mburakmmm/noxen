# validators.nox — Core validators and constraint checkers for Noxen.

import nox.url
import nox.regex
import nox.strings
from nox.url import URL, UrlError

def is_valid_email(s: str) -> bool:
    if nox.strings.contains(s, " "):
        return False
    parts: list[str] = nox.strings.split(s, "@")
    if len(parts) != 2:
        return False
    local: str = parts[0]
    domain: str = parts[1]
    if len(local) == 0 or len(domain) < 3:
        return False
    dot: int = nox.strings.index_of(domain, ".")
    if dot <= 0:
        return False
    if nox.strings.ends_with(domain, "."):
        return False
    return True

def is_valid_url(s: str) -> bool:
    try:
        u: URL = nox.url.parse(s)
        if len(u.scheme) == 0 or len(u.host) == 0:
            return False
        if u.scheme != "http" and u.scheme != "https":
            return False
        return True
    except UrlError as e:
        return False

def _is_hex(b: int) -> bool:
    return (b >= 48 and b <= 57) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)

def _is_digit(b: int) -> bool:
    return b >= 48 and b <= 57

def is_valid_date(s: str) -> bool:
    if len(s) != 10:
        return False
    if nox.strings.byte_at(s, 4) != 45 or nox.strings.byte_at(s, 7) != 45: # '-'
        return False
    i: int = 0
    while i < 10:
        if i != 4 and i != 7:
            if not _is_digit(nox.strings.byte_at(s, i)):
                return False
        i = i + 1
    y_str: str = s[0:4]
    m_str: str = s[5:7]
    d_str: str = s[8:10]
    y: int = int(y_str)
    m: int = int(m_str)
    d: int = int(d_str)
    if y < 1 or m < 1 or m > 12 or d < 1:
        return False
    max_d: int = 31
    if m == 4 or m == 6 or m == 9 or m == 11:
        max_d = 30
    elif m == 2:
        is_leap: bool = (y % 4 == 0) and ((y % 100 != 0) or (y % 400 == 0))
        if is_leap:
            max_d = 29
        else:
            max_d = 28
    return d <= max_d

def is_valid_time(s: str) -> bool:
    if len(s) < 8:
        return False
    if nox.strings.byte_at(s, 2) != 58 or nox.strings.byte_at(s, 5) != 58: # ':'
        return False
    if not _is_digit(nox.strings.byte_at(s, 0)) or not _is_digit(nox.strings.byte_at(s, 1)):
        return False
    if not _is_digit(nox.strings.byte_at(s, 3)) or not _is_digit(nox.strings.byte_at(s, 4)):
        return False
    if not _is_digit(nox.strings.byte_at(s, 6)) or not _is_digit(nox.strings.byte_at(s, 7)):
        return False
    h: int = int(s[0:2])
    m: int = int(s[3:5])
    sec: int = int(s[6:8])
    if h < 0 or h > 23 or m < 0 or m > 59 or sec < 0 or sec > 59:
        return False
    if len(s) > 8:
        rem: str = s[8:len(s)]
        if rem == "Z":
            return True
        if (rem[0:1] == "+" or rem[0:1] == "-") and len(rem) == 6 and rem[3:4] == ":":
            zh: int = int(rem[1:3])
            zm: int = int(rem[4:6])
            return zh >= 0 and zh <= 23 and zm >= 0 and zm <= 59
        if rem[0:1] == ".":
            return True
        return False
    return True

def is_valid_datetime(s: str) -> bool:
    t_idx: int = nox.strings.index_of(s, "T")
    if t_idx < 0:
        t_idx = nox.strings.index_of(s, " ")
    if t_idx != 10:
        return False
    date_part: str = s[0:10]
    time_part: str = s[11:len(s)]
    return is_valid_date(date_part) and is_valid_time(time_part)

def is_valid_uuid(s: str) -> bool:
    if nox.strings.byte_len(s) != 36:
        return False
    i: int = 0
    while i < 36:
        b: int = nox.strings.byte_at(s, i)
        if i == 8 or i == 13 or i == 18 or i == 23:
            if b != 45:
                return False
        else:
            if not _is_hex(b):
                return False
        i = i + 1
    return True

# Checks if a floating point value safely represents an integer without precision loss.
def is_valid_int(n: float) -> bool:
    if n > 9007199254740991.0 or n < -9007199254740991.0:
        return False
    i: int = int(n)
    return float(i) == n
