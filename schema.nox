# schema.nox — Declarative schema definition, validation engine, and JSON Schema generation.

import nox.reflect
import errors
from errors import FieldError, CODE_INVALID_JSON, CODE_EXPECTED_OBJECT, CODE_MISSING_FIELD, CODE_UNEXPECTED_NULL, CODE_TYPE_MISMATCH, CODE_EXTRA_FIELD, CODE_OUT_OF_RANGE, CODE_STRING_TOO_SHORT, CODE_STRING_TOO_LONG, CODE_INVALID_EMAIL, CODE_INVALID_URL, CODE_INVALID_UUID, CODE_INVALID_DATE, CODE_INVALID_TIME, CODE_INVALID_DATETIME, CODE_INVALID_TIMEZONE, CODE_INVALID_IP, CODE_PATTERN_MISMATCH, CODE_CHOICE_MISMATCH, CODE_ARRAY_TOO_SHORT, CODE_ARRAY_TOO_LONG, CODE_RECURSION_LIMIT, CODE_MAX_ERRORS_EXCEEDED, CODE_INVALID_TOML, CODE_INVALID_YAML
import validators
import core
from core import ValidatedData, ValidationResult
import serialization
from serialization import Serializer, is_finite_float
import nox.json
import nox.regex
from nox.regex import RegexError
import nox.strings
import nox.unicode
import nox.db
import nox.toml
