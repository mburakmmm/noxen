# schema.nox — Declarative schema definition, validation engine, and JSON Schema generation.

import errors
from errors import FieldError, CODE_INVALID_JSON, CODE_EXPECTED_OBJECT, CODE_MISSING_FIELD, CODE_UNEXPECTED_NULL, CODE_TYPE_MISMATCH, CODE_EXTRA_FIELD, CODE_OUT_OF_RANGE, CODE_STRING_TOO_SHORT, CODE_STRING_TOO_LONG, CODE_INVALID_EMAIL, CODE_INVALID_URL, CODE_INVALID_UUID, CODE_INVALID_DATE, CODE_INVALID_TIME, CODE_INVALID_DATETIME, CODE_PATTERN_MISMATCH, CODE_CHOICE_MISMATCH, CODE_ARRAY_TOO_SHORT, CODE_ARRAY_TOO_LONG, CODE_RECURSION_LIMIT, CODE_MAX_ERRORS_EXCEEDED
import validators
import core
from core import ValidatedData, ValidationResult
import serialization
from serialization import Serializer
import nox.json
import nox.regex
import nox.strings
import nox.db
from nox.db import Row
from nox.json import JsonError, JsonWriter

# Presence modes
MODE_REQUIRED: int = 0
MODE_REQUIRED_NULLABLE: int = 1
MODE_OPTIONAL: int = 2
MODE_OPTIONAL_NULLABLE: int = 3

# Unknown field policies
POLICY_FORBID: int = 0
POLICY_IGNORE: int = 1
POLICY_ALLOW: int = 2

# Coercion modes
COERCION_STRICT: int = 0
COERCION_LAX: int = 1

def _describe_json_kind(v: JsonValue) -> str:
    if nox.json.is_null(v):
        return "null"
    if nox.json.is_bool(v):
        return "bool"
    if nox.json.is_number(v):
        return "number"
    if nox.json.is_string(v):
        return "string"
    if nox.json.is_array(v):
        return "array"
    if nox.json.is_object(v):
        return "object"
    return "unknown"

def _object_lookup(v: JsonValue, key: str) -> JsonValue | None:
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == key:
            return nox.json.object_value(v, i)
        i = i + 1
    return None

def _try_coerce_int(s: str) -> int | None:
    if len(s) == 0:
        return None
    try:
        return int(s)
    except ValueError as e:
        return None

def _try_coerce_float(s: str) -> float | None:
    if len(s) == 0:
        return None
    try:
        return float(s)
    except ValueError as e:
        return None

def _try_coerce_bool(s: str) -> bool | None:
    if s == "true" or s == "True" or s == "1":
        return True
    if s == "false" or s == "False" or s == "0":
        return False
    return None

class Field:
    name: str
    json_name: str
    kind: str
    mode: int
    has_default: bool
    default_str: str
    default_int: int
    default_float: float
    default_bool: bool
    has_min: bool
    min_val: float
    is_exclusive_min: bool
    has_min_int: bool
    min_val_int: int
    has_max: bool
    max_val: float
    is_exclusive_max: bool
    has_max_int: bool
    max_val_int: int
    has_min_len: bool
    min_len: int
    has_max_len: bool
    max_len: int
    pattern: str
    fmt: str
    item_kind: str
    has_min_items: bool
    min_items: int
    has_max_items: bool
    max_items: int
    choices: list[str]
    choices_int: list[int]
    nested_schema: Schema | None
    item_schema: Schema | None
    description: str
    is_secret: bool
    is_date: bool
    is_time: bool
    is_datetime: bool

    def __init__(self: Field, name: str, kind: str) -> None:
        self.name = name
        self.json_name = ""
        self.kind = kind
        self.mode = MODE_REQUIRED
        self.has_default = False
        self.default_str = ""
        self.default_int = 0
        self.default_float = 0.0
        self.default_bool = False
        self.has_min = False
        self.min_val = 0.0
        self.is_exclusive_min = False
        self.has_min_int = False
        self.min_val_int = 0
        self.has_max = False
        self.max_val = 0.0
        self.is_exclusive_max = False
        self.has_max_int = False
        self.max_val_int = 0
        self.has_min_len = False
        self.min_len = 0
        self.has_max_len = False
        self.max_len = 0
        self.pattern = ""
        self.fmt = ""
        self.item_kind = ""
        self.has_min_items = False
        self.min_items = 0
        self.has_max_items = False
        self.max_items = 0
        self.choices = []
        self.choices_int = []
        self.nested_schema = None
        self.item_schema = None
        self.description = ""
        self.is_secret = False
        self.is_date = False
        self.is_time = False
        self.is_datetime = False

    def alias(self: Field, json_key: str) -> Field:
        self.json_name = json_key
        return self

    def optional(self: Field) -> Field:
        if self.mode == MODE_REQUIRED:
            self.mode = MODE_OPTIONAL
        elif self.mode == MODE_REQUIRED_NULLABLE:
            self.mode = MODE_OPTIONAL_NULLABLE
        return self

    def nullable(self: Field) -> Field:
        if self.mode == MODE_REQUIRED:
            self.mode = MODE_REQUIRED_NULLABLE
        elif self.mode == MODE_OPTIONAL:
            self.mode = MODE_OPTIONAL_NULLABLE
        return self

    def default_s(self: Field, v: str) -> Field:
        self.has_default = True
        self.default_str = v
        self.optional()
        return self

    def default_i(self: Field, v: int) -> Field:
        self.has_default = True
        self.default_int = v
        self.optional()
        return self

    def default_f(self: Field, v: float) -> Field:
        self.has_default = True
        self.default_float = v
        self.optional()
        return self

    def default_b(self: Field, v: bool) -> Field:
        self.has_default = True
        self.default_bool = v
        self.optional()
        return self

    def min(self: Field, v: float) -> Field:
        self.has_min = True
        self.min_val = v
        self.is_exclusive_min = False
        if self.kind == "int":
            self.has_min_int = True
            self.min_val_int = int(v)
        return self

    def ge(self: Field, v: float) -> Field:
        return self.min(v)

    def gt(self: Field, v: float) -> Field:
        self.has_min = True
        self.min_val = v
        self.is_exclusive_min = True
        if self.kind == "int":
            self.has_min_int = True
            self.min_val_int = int(v)
        return self

    def max(self: Field, v: float) -> Field:
        self.has_max = True
        self.max_val = v
        self.is_exclusive_max = False
        if self.kind == "int":
            self.has_max_int = True
            self.max_val_int = int(v)
        return self

    def le(self: Field, v: float) -> Field:
        return self.max(v)

    def lt(self: Field, v: float) -> Field:
        self.has_max = True
        self.max_val = v
        self.is_exclusive_max = True
        if self.kind == "int":
            self.has_max_int = True
            self.max_val_int = int(v)
        return self

    def min_i(self: Field, v: int) -> Field:
        self.has_min_int = True
        self.min_val_int = v
        self.is_exclusive_min = False
        self.has_min = True
        self.min_val = float(v)
        return self

    def ge_i(self: Field, v: int) -> Field:
        return self.min_i(v)

    def max_i(self: Field, v: int) -> Field:
        self.has_max_int = True
        self.max_val_int = v
        self.is_exclusive_max = False
        self.has_max = True
        self.max_val = float(v)
        return self

    def le_i(self: Field, v: int) -> Field:
        return self.max_i(v)

    def min_length(self: Field, n: int) -> Field:
        self.has_min_len = True
        self.min_len = n
        return self

    def max_length(self: Field, n: int) -> Field:
        self.has_max_len = True
        self.max_len = n
        return self

    def min_items(self: Field, n: int) -> Field:
        self.has_min_items = True
        self.min_items = n
        return self

    def max_items(self: Field, n: int) -> Field:
        self.has_max_items = True
        self.max_items = n
        return self

    def in_choices(self: Field, opts: list[str]) -> Field:
        self.choices = opts
        return self

    def in_choices_int(self: Field, opts: list[int]) -> Field:
        self.choices_int = opts
        return self

    def regex(self: Field, pat: str) -> Field:
        self.pattern = pat
        return self

    def email(self: Field) -> Field:
        self.fmt = "email"
        return self

    def url(self: Field) -> Field:
        self.fmt = "url"
        return self

    def uuid(self: Field) -> Field:
        self.fmt = "uuid"
        return self

    def date(self: Field) -> Field:
        self.is_date = True
        self.fmt = "date"
        return self

    def time(self: Field) -> Field:
        self.is_time = True
        self.fmt = "time"
        return self

    def datetime(self: Field) -> Field:
        self.is_datetime = True
        self.fmt = "date-time"
        return self

    def secret(self: Field) -> Field:
        self.is_secret = True
        return self

    def describe(self: Field, desc: str) -> Field:
        self.description = desc
        return self

class Schema:
    name: str
    fields: list[Field]
    policy: int
    coercion: int
    max_depth: int
    max_errors: int
    custom_validators: list[(ValidatedData) -> list[FieldError]]

    def __init__(self: Schema, name: str) -> None:
        self.name = name
        self.fields = []
        self.policy = POLICY_FORBID
        self.coercion = COERCION_STRICT
        self.max_depth = 32
        self.max_errors = 50
        self.custom_validators = []

    def set_policy(self: Schema, policy: int) -> None:
        self.policy = policy

    def set_coercion(self: Schema, mode: int) -> None:
        self.coercion = mode

    def set_max_depth(self: Schema, depth: int) -> None:
        self.max_depth = depth

    def set_max_errors(self: Schema, limit: int) -> None:
        self.max_errors = limit

    def add_validator(self: Schema, v: (ValidatedData) -> list[FieldError]) -> None:
        self.custom_validators.append(v)

    def _add_field(self: Schema, f: Field) -> Field:
        self.fields.append(f)
        return f

    def field_str(self: Schema, name: str) -> Field:
        f: Field = Field(name, "string")
        return self._add_field(f)

    def field_int(self: Schema, name: str) -> Field:
        f: Field = Field(name, "int")
        return self._add_field(f)

    def field_float(self: Schema, name: str) -> Field:
        f: Field = Field(name, "float")
        return self._add_field(f)

    def field_bool(self: Schema, name: str) -> Field:
        f: Field = Field(name, "bool")
        return self._add_field(f)

    def field_object(self: Schema, name: str, sub: Schema) -> Field:
        f: Field = Field(name, "object")
        f.nested_schema = sub
        return self._add_field(f)

    def field_list(self: Schema, name: str, item_kind: str) -> Field:
        f: Field = Field(name, "list")
        f.item_kind = item_kind
        return self._add_field(f)

    def field_list_schema(self: Schema, name: str, sub: Schema) -> Field:
        f: Field = Field(name, "list")
        f.item_kind = "object"
        f.item_schema = sub
        return self._add_field(f)

    def get_field(self: Schema, name: str) -> Field | None:
        i: int = 0
        while i < len(self.fields):
            f: Field = self.fields[i]
            if f.name == name or (len(f.json_name) > 0 and f.json_name == name):
                return f
            i = i + 1
        return None

    def validate_at(self: Schema, v: JsonValue, prefix: str, depth: int) -> ValidationResult:
        data: ValidatedData = ValidatedData()
        err_list: list[FieldError] = []

        if depth > self.max_depth:
            err_list.append(
                FieldError(prefix, CODE_RECURSION_LIMIT, "Maximum nesting depth (" + str(self.max_depth) + ") exceeded", "depth <= " + str(self.max_depth), str(depth))
            )
            return ValidationResult(False, data, err_list)

        if not nox.json.is_object(v):
            p: str = prefix
            if p == "":
                p = "root"
            err_list.append(
                FieldError(p, CODE_EXPECTED_OBJECT, "Expected a JSON object at " + p, "object", _describe_json_kind(v))
            )
            return ValidationResult(False, data, err_list)

        # Policy check: unknown/extra fields
        if self.policy == POLICY_FORBID:
            n_keys: int = nox.json.object_len(v)
            ki: int = 0
            while ki < n_keys:
                k: str = nox.json.object_key(v, ki)
                matched: Field | None = self.get_field(k)
                if matched is None:
                    p_extra: str = k
                    if prefix != "":
                        p_extra = prefix + "." + k
                    err_list.append(
                        FieldError(p_extra, CODE_EXTRA_FIELD, "Unexpected unknown field: '" + p_extra + "'", "none", "present")
                    )
                    if len(err_list) >= self.max_errors:
                        err_list.append(FieldError(prefix, CODE_MAX_ERRORS_EXCEEDED, "Error limit reached", str(self.max_errors), str(len(err_list))))
                        return ValidationResult(False, data, err_list)
                ki = ki + 1
        elif self.policy == POLICY_ALLOW:
            n_keys_allow: int = nox.json.object_len(v)
            ki_allow: int = 0
            while ki_allow < n_keys_allow:
                k_allow: str = nox.json.object_key(v, ki_allow)
                matched_allow: Field | None = self.get_field(k_allow)
                if matched_allow is None:
                    extra_val: JsonValue = nox.json.object_value(v, ki_allow)
                    data.set_extra(k_allow, nox.json.dump(extra_val))
                ki_allow = ki_allow + 1

        # Field validations in schema order
        fi: int = 0
        while fi < len(self.fields):
            field: Field = self.fields[fi]
            effective_key: str = field.name
            if len(field.json_name) > 0:
                effective_key = field.json_name

            full_path: str = field.name
            if prefix != "":
                full_path = prefix + "." + field.name

            raw_val: JsonValue | None = _object_lookup(v, effective_key)
            if raw_val is None:
                # Missing from JSON
                if field.has_default:
                    if field.kind == "string":
                        data.set_str(field.name, field.default_str)
                    elif field.kind == "int":
                        data.set_int(field.name, field.default_int)
                    elif field.kind == "float":
                        data.set_float(field.name, field.default_float)
                    elif field.kind == "bool":
                        data.set_bool(field.name, field.default_bool)
                elif field.mode == MODE_REQUIRED or field.mode == MODE_REQUIRED_NULLABLE:
                    err_list.append(
                        FieldError(full_path, CODE_MISSING_FIELD, "Missing required field: '" + full_path + "'", field.kind, "missing")
                    )
            else:
                field_val: JsonValue = raw_val
                if nox.json.is_null(field_val):
                    if field.mode == MODE_REQUIRED_NULLABLE or field.mode == MODE_OPTIONAL_NULLABLE:
                        data.set_null(field.name)
                    else:
                        err_list.append(
                            FieldError(full_path, CODE_UNEXPECTED_NULL, "Field '" + full_path + "' cannot be null", "non-null " + field.kind, "null")
                        )
                else:
                    # Present and not null
                    if field.kind == "string":
                        sv_opt: str | None = None
                        if nox.json.is_string(field_val):
                            sv_opt = nox.json.as_string(field_val)
                        elif self.coercion == COERCION_LAX:
                            if nox.json.is_number(field_val):
                                sv_opt = str(nox.json.as_number(field_val))
                            elif nox.json.is_bool(field_val):
                                if nox.json.as_bool(field_val):
                                    sv_opt = "true"
                                else:
                                    sv_opt = "false"

                        if sv_opt is None:
                            err_list.append(
                                FieldError(full_path, CODE_TYPE_MISMATCH, "Field '" + full_path + "' expected string", "string", _describe_json_kind(field_val))
                            )
                        else:
                            sv: str = sv_opt
                            actual_repr: str = sv
                            if field.is_secret:
                                actual_repr = "[REDACTED]"

                            if field.has_min_len and len(sv) < field.min_len:
                                err_list.append(
                                    FieldError(full_path, CODE_STRING_TOO_SHORT, "Field '" + full_path + "' must have at least " + str(field.min_len) + " characters", "length >= " + str(field.min_len), str(len(sv)))
                                )
                            if field.has_max_len and len(sv) > field.max_len:
                                err_list.append(
                                    FieldError(full_path, CODE_STRING_TOO_LONG, "Field '" + full_path + "' must have at most " + str(field.max_len) + " characters", "length <= " + str(field.max_len), str(len(sv)))
                                )
                            if len(field.choices) > 0:
                                matched_choice: bool = False
                                ci: int = 0
                                while ci < len(field.choices):
                                    if field.choices[ci] == sv:
                                        matched_choice = True
                                    ci = ci + 1
                                if not matched_choice:
                                    err_list.append(
                                        FieldError(full_path, CODE_CHOICE_MISMATCH, "Field '" + full_path + "' must be one of the allowed choices", "choice", actual_repr)
                                    )
                            if len(field.pattern) > 0 and not nox.regex.is_match(field.pattern, sv):
                                err_list.append(
                                    FieldError(full_path, CODE_PATTERN_MISMATCH, "Field '" + full_path + "' does not match pattern: " + field.pattern, field.pattern, actual_repr)
                                )
                            if field.fmt == "email" and not validators.is_valid_email(sv):
                                err_list.append(
                                    FieldError(full_path, CODE_INVALID_EMAIL, "Field '" + full_path + "' is not a valid email address", "email", actual_repr)
                                )
                            if field.fmt == "url" and not validators.is_valid_url(sv):
                                err_list.append(
                                    FieldError(full_path, CODE_INVALID_URL, "Field '" + full_path + "' is not a valid absolute URL", "url", actual_repr)
                                )
                            if field.fmt == "uuid" and not validators.is_valid_uuid(sv):
                                err_list.append(
                                    FieldError(full_path, CODE_INVALID_UUID, "Field '" + full_path + "' is not a valid UUID", "uuid", actual_repr)
                                )
                            if field.fmt == "date" and not validators.is_valid_date(sv):
                                err_list.append(
                                    FieldError(full_path, CODE_INVALID_DATE, "Field '" + full_path + "' is not a valid ISO 8601 date (YYYY-MM-DD)", "date", actual_repr)
                                )
                            if field.fmt == "time" and not validators.is_valid_time(sv):
                                err_list.append(
                                    FieldError(full_path, CODE_INVALID_TIME, "Field '" + full_path + "' is not a valid ISO 8601 time (HH:MM:SS)", "time", actual_repr)
                                )
                            if field.fmt == "date-time" and not validators.is_valid_datetime(sv):
                                err_list.append(
                                    FieldError(full_path, CODE_INVALID_DATETIME, "Field '" + full_path + "' is not a valid ISO 8601 datetime", "date-time", actual_repr)
                                )
                            data.set_str(field.name, sv)

                    elif field.kind == "int":
                        iv_opt: int | None = None
                        if nox.json.is_number(field_val):
                            nv: float = nox.json.as_number(field_val)
                            if validators.is_valid_int(nv):
                                iv_opt = int(nv)
                        elif self.coercion == COERCION_LAX and nox.json.is_string(field_val):
                            iv_opt = _try_coerce_int(nox.json.as_string(field_val))

                        if iv_opt is None:
                            err_list.append(
                                FieldError(full_path, CODE_TYPE_MISMATCH, "Field '" + full_path + "' expected integer", "int", _describe_json_kind(field_val))
                            )
                        else:
                            iv: int = iv_opt
                            if field.has_min_int:
                                if field.is_exclusive_min:
                                    if iv <= field.min_val_int:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be strictly greater than " + str(field.min_val_int), "> " + str(field.min_val_int), str(iv))
                                        )
                                else:
                                    if iv < field.min_val_int:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be at least " + str(field.min_val_int), ">= " + str(field.min_val_int), str(iv))
                                        )
                            elif field.has_min:
                                if field.is_exclusive_min:
                                    if float(iv) <= field.min_val:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be strictly greater than " + str(field.min_val), "> " + str(field.min_val), str(iv))
                                        )
                                else:
                                    if float(iv) < field.min_val:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be at least " + str(field.min_val), ">= " + str(field.min_val), str(iv))
                                        )
                            if field.has_max_int:
                                if field.is_exclusive_max:
                                    if iv >= field.max_val_int:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be strictly less than " + str(field.max_val_int), "< " + str(field.max_val_int), str(iv))
                                        )
                                else:
                                    if iv > field.max_val_int:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be at most " + str(field.max_val_int), "<= " + str(field.max_val_int), str(iv))
                                        )
                            elif field.has_max:
                                if field.is_exclusive_max:
                                    if float(iv) >= field.max_val:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be strictly less than " + str(field.max_val), "< " + str(field.max_val), str(iv))
                                        )
                                else:
                                    if float(iv) > field.max_val:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be at most " + str(field.max_val), "<= " + str(field.max_val), str(iv))
                                        )
                            if len(field.choices_int) > 0:
                                matched_i: bool = False
                                cii: int = 0
                                while cii < len(field.choices_int):
                                    if field.choices_int[cii] == iv:
                                        matched_i = True
                                    cii = cii + 1
                                if not matched_i:
                                    err_list.append(
                                        FieldError(full_path, CODE_CHOICE_MISMATCH, "Field '" + full_path + "' must be one of the allowed integer choices", "int choice", str(iv))
                                    )
                            data.set_int(field.name, iv)

                    elif field.kind == "float":
                        fv_opt: float | None = None
                        if nox.json.is_number(field_val):
                            fv_opt = nox.json.as_number(field_val)
                        elif self.coercion == COERCION_LAX and nox.json.is_string(field_val):
                            fv_opt = _try_coerce_float(nox.json.as_string(field_val))

                        if fv_opt is None:
                            err_list.append(
                                FieldError(full_path, CODE_TYPE_MISMATCH, "Field '" + full_path + "' expected float", "float", _describe_json_kind(field_val))
                            )
                        else:
                            fv: float = fv_opt
                            if field.has_min:
                                if field.is_exclusive_min:
                                    if fv <= field.min_val:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be strictly greater than " + str(field.min_val), "> " + str(field.min_val), str(fv))
                                        )
                                else:
                                    if fv < field.min_val:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be at least " + str(field.min_val), ">= " + str(field.min_val), str(fv))
                                        )
                            if field.has_max:
                                if field.is_exclusive_max:
                                    if fv >= field.max_val:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be strictly less than " + str(field.max_val), "< " + str(field.max_val), str(fv))
                                        )
                                else:
                                    if fv > field.max_val:
                                        err_list.append(
                                            FieldError(full_path, CODE_OUT_OF_RANGE, "Field '" + full_path + "' must be at most " + str(field.max_val), "<= " + str(field.max_val), str(fv))
                                        )
                            data.set_float(field.name, fv)

                    elif field.kind == "bool":
                        bv_opt: bool | None = None
                        if nox.json.is_bool(field_val):
                            bv_opt = nox.json.as_bool(field_val)
                        elif self.coercion == COERCION_LAX and nox.json.is_string(field_val):
                            bv_opt = _try_coerce_bool(nox.json.as_string(field_val))

                        if bv_opt is None:
                            err_list.append(
                                FieldError(full_path, CODE_TYPE_MISMATCH, "Field '" + full_path + "' expected boolean", "bool", _describe_json_kind(field_val))
                            )
                        else:
                            data.set_bool(field.name, bv_opt)

                    elif field.kind == "object":
                        if not nox.json.is_object(field_val):
                            err_list.append(
                                FieldError(full_path, CODE_TYPE_MISMATCH, "Field '" + full_path + "' expected object", "object", _describe_json_kind(field_val))
                            )
                        else:
                            sub: Schema | None = field.nested_schema
                            if sub is not None:
                                if sub.max_depth > self.max_depth:
                                    sub.max_depth = self.max_depth
                                sub_res: ValidationResult = sub.validate_at(field_val, full_path, depth + 1)
                                if not sub_res.is_valid:
                                    si: int = 0
                                    while si < len(sub_res.errors):
                                        err_list.append(sub_res.errors[si])
                                        si = si + 1
                                else:
                                    data.set_object(field.name, sub_res.data)

                    elif field.kind == "list":
                        if not nox.json.is_array(field_val):
                            err_list.append(
                                FieldError(full_path, CODE_TYPE_MISMATCH, "Field '" + full_path + "' expected array", "list", _describe_json_kind(field_val))
                            )
                        else:
                            alen: int = nox.json.array_len(field_val)
                            if field.has_min_items and alen < field.min_items:
                                err_list.append(
                                    FieldError(full_path, CODE_ARRAY_TOO_SHORT, "Array '" + full_path + "' must contain at least " + str(field.min_items) + " items", "length >= " + str(field.min_items), str(alen))
                                )
                            if field.has_max_items and alen > field.max_items:
                                err_list.append(
                                    FieldError(full_path, CODE_ARRAY_TOO_LONG, "Array '" + full_path + "' must contain at most " + str(field.max_items) + " items", "length <= " + str(field.max_items), str(alen))
                                )

                            if field.item_kind == "string":
                                s_items: list[str] = []
                                ai: int = 0
                                while ai < alen:
                                    el: JsonValue = nox.json.array_get(field_val, ai)
                                    el_path: str = full_path + "[" + str(ai) + "]"
                                    if not nox.json.is_string(el):
                                        err_list.append(
                                            FieldError(el_path, CODE_TYPE_MISMATCH, "Element '" + el_path + "' expected string", "string", _describe_json_kind(el))
                                        )
                                    else:
                                        s_items.append(nox.json.as_string(el))
                                    ai = ai + 1
                                data.set_list_str(field.name, s_items)

                            elif field.item_kind == "int":
                                i_items: list[int] = []
                                ai: int = 0
                                while ai < alen:
                                    el: JsonValue = nox.json.array_get(field_val, ai)
                                    el_path: str = full_path + "[" + str(ai) + "]"
                                    if not nox.json.is_number(el) or not validators.is_valid_int(nox.json.as_number(el)):
                                        err_list.append(
                                            FieldError(el_path, CODE_TYPE_MISMATCH, "Element '" + el_path + "' expected integer", "int", _describe_json_kind(el))
                                        )
                                    else:
                                        i_items.append(int(nox.json.as_number(el)))
                                    ai = ai + 1
                                data.set_list_int(field.name, i_items)

                            elif field.item_kind == "float":
                                f_items: list[float] = []
                                ai: int = 0
                                while ai < alen:
                                    el: JsonValue = nox.json.array_get(field_val, ai)
                                    el_path: str = full_path + "[" + str(ai) + "]"
                                    if not nox.json.is_number(el):
                                        err_list.append(
                                            FieldError(el_path, CODE_TYPE_MISMATCH, "Element '" + el_path + "' expected float", "float", _describe_json_kind(el))
                                        )
                                    else:
                                        f_items.append(nox.json.as_number(el))
                                    ai = ai + 1
                                data.set_list_float(field.name, f_items)

                            elif field.item_kind == "bool":
                                b_items: list[bool] = []
                                ai: int = 0
                                while ai < alen:
                                    el: JsonValue = nox.json.array_get(field_val, ai)
                                    el_path: str = full_path + "[" + str(ai) + "]"
                                    if not nox.json.is_bool(el):
                                        err_list.append(
                                            FieldError(el_path, CODE_TYPE_MISMATCH, "Element '" + el_path + "' expected boolean", "bool", _describe_json_kind(el))
                                        )
                                    else:
                                        b_items.append(nox.json.as_bool(el))
                                    ai = ai + 1
                                data.set_list_bool(field.name, b_items)

                            elif field.item_kind == "object":
                                o_items: list[ValidatedData] = []
                                item_sub: Schema | None = field.item_schema
                                ai: int = 0
                                while ai < alen:
                                    el: JsonValue = nox.json.array_get(field_val, ai)
                                    el_path: str = full_path + "[" + str(ai) + "]"
                                    if not nox.json.is_object(el):
                                        err_list.append(
                                            FieldError(el_path, CODE_TYPE_MISMATCH, "Element '" + el_path + "' expected object", "object", _describe_json_kind(el))
                                        )
                                    else:
                                        if item_sub is not None:
                                            if item_sub.max_depth > self.max_depth:
                                                item_sub.max_depth = self.max_depth
                                            el_res: ValidationResult = item_sub.validate_at(el, el_path, depth + 1)
                                            if not el_res.is_valid:
                                                ei: int = 0
                                                while ei < len(el_res.errors):
                                                    err_list.append(el_res.errors[ei])
                                                    ei = ei + 1
                                            else:
                                                o_items.append(el_res.data)
                                    ai = ai + 1
                                data.set_list_object(field.name, o_items)

            if len(err_list) >= self.max_errors:
                err_list.append(FieldError(prefix, CODE_MAX_ERRORS_EXCEEDED, "Error limit reached", str(self.max_errors), str(len(err_list))))
                return ValidationResult(False, data, err_list)

            fi = fi + 1

        # Run custom validators only if field-level checks had no errors
        if len(err_list) == 0:
            cvi: int = 0
            while cvi < len(self.custom_validators):
                cv: (ValidatedData) -> list[FieldError] = self.custom_validators[cvi]
                c_errs: list[FieldError] = cv(data)
                ci: int = 0
                while ci < len(c_errs):
                    err_list.append(c_errs[ci])
                    ci = ci + 1
                cvi = cvi + 1

        return ValidationResult(len(err_list) == 0, data, err_list)

    def validate(self: Schema, v: JsonValue) -> ValidationResult:
        return self.validate_at(v, "", 0)

    def validate_row(self: Schema, row: Row) -> ValidationResult:
        data: ValidatedData = ValidatedData()
        err_list: list[FieldError] = []

        # 1. Unknown columns policy check
        if self.policy == POLICY_FORBID:
            n_cols: int = row.column_count()
            ci: int = 0
            while ci < n_cols:
                col: str = row.column_name(ci)
                matched: Field | None = self.get_field(col)
                if matched is None:
                    err_list.append(
                        FieldError(col, CODE_EXTRA_FIELD, "Unexpected unknown column in database row: '" + col + "'", "none", "present")
                    )
                ci = ci + 1
        elif self.policy == POLICY_ALLOW:
            n_cols_a: int = row.column_count()
            cia: int = 0
            while cia < n_cols_a:
                cola: str = row.column_name(cia)
                matched_a: Field | None = self.get_field(cola)
                if matched_a is None:
                    if row.is_null(cia):
                        data.set_extra(cola, "null")
                    else:
                        data.set_extra(cola, "\"" + row.get_str(cia) + "\"")
                cia = cia + 1

        # 2. Validate declared fields against row
        fi: int = 0
        while fi < len(self.fields):
            field: Field = self.fields[fi]
            target_name: str = field.name
            if len(field.json_name) > 0:
                target_name = field.json_name

            col_idx: int = -1
            rci: int = 0
            while rci < row.column_count():
                cname: str = row.column_name(rci)
                if cname == target_name or cname == field.name:
                    col_idx = rci
                rci = rci + 1

            if col_idx == -1:
                # Column not present in row
                if field.has_default:
                    if field.kind == "string":
                        data.set_str(field.name, field.default_str)
                    elif field.kind == "int":
                        data.set_int(field.name, field.default_int)
                    elif field.kind == "float":
                        data.set_float(field.name, field.default_float)
                    elif field.kind == "bool":
                        data.set_bool(field.name, field.default_bool)
                elif field.mode == MODE_REQUIRED or field.mode == MODE_REQUIRED_NULLABLE:
                    err_list.append(
                        FieldError(field.name, CODE_MISSING_FIELD, "Missing required database column: '" + field.name + "'", field.kind, "missing")
                    )
            else:
                # Column is present in row
                if row.is_null(col_idx):
                    if field.mode == MODE_REQUIRED_NULLABLE or field.mode == MODE_OPTIONAL_NULLABLE:
                        data.set_null(field.name)
                    else:
                        err_list.append(
                            FieldError(field.name, CODE_UNEXPECTED_NULL, "Database column '" + field.name + "' cannot be null", "non-null " + field.kind, "null")
                        )
                else:
                    raw_str: str = row.get_str(col_idx)
                    actual_repr: str = raw_str
                    if field.is_secret:
                        actual_repr = "[REDACTED]"

                    if field.kind == "string":
                        if field.has_min_len and len(raw_str) < field.min_len:
                            err_list.append(
                                FieldError(field.name, CODE_STRING_TOO_SHORT, "Field '" + field.name + "' must have at least " + str(field.min_len) + " characters", "length >= " + str(field.min_len), str(len(raw_str)))
                            )
                        if field.has_max_len and len(raw_str) > field.max_len:
                            err_list.append(
                                FieldError(field.name, CODE_STRING_TOO_LONG, "Field '" + field.name + "' must have at most " + str(field.max_len) + " characters", "length <= " + str(field.max_len), str(len(raw_str)))
                            )
                        if len(field.choices) > 0:
                            matched_ch: bool = False
                            chi: int = 0
                            while chi < len(field.choices):
                                if field.choices[chi] == raw_str:
                                    matched_ch = True
                                chi = chi + 1
                            if not matched_ch:
                                err_list.append(
                                    FieldError(field.name, CODE_CHOICE_MISMATCH, "Field '" + field.name + "' must be one of the allowed choices", "choice", actual_repr)
                                )
                        if len(field.pattern) > 0 and not nox.regex.is_match(field.pattern, raw_str):
                            err_list.append(
                                FieldError(field.name, CODE_PATTERN_MISMATCH, "Field '" + field.name + "' does not match pattern: " + field.pattern, field.pattern, actual_repr)
                            )
                        if field.fmt == "email" and not validators.is_valid_email(raw_str):
                            err_list.append(
                                FieldError(field.name, CODE_INVALID_EMAIL, "Field '" + field.name + "' is not a valid email address", "email", actual_repr)
                            )
                        if field.fmt == "url" and not validators.is_valid_url(raw_str):
                            err_list.append(
                                FieldError(field.name, CODE_INVALID_URL, "Field '" + field.name + "' is not a valid absolute URL", "url", actual_repr)
                            )
                        if field.fmt == "uuid" and not validators.is_valid_uuid(raw_str):
                            err_list.append(
                                FieldError(field.name, CODE_INVALID_UUID, "Field '" + field.name + "' is not a valid UUID", "uuid", actual_repr)
                            )
                        if field.fmt == "date" and not validators.is_valid_date(raw_str):
                            err_list.append(
                                FieldError(field.name, CODE_INVALID_DATE, "Field '" + field.name + "' is not a valid ISO 8601 date (YYYY-MM-DD)", "date", actual_repr)
                            )
                        if field.fmt == "time" and not validators.is_valid_time(raw_str):
                            err_list.append(
                                FieldError(field.name, CODE_INVALID_TIME, "Field '" + field.name + "' is not a valid ISO 8601 time (HH:MM:SS)", "time", actual_repr)
                            )
                        if field.fmt == "date-time" and not validators.is_valid_datetime(raw_str):
                            err_list.append(
                                FieldError(field.name, CODE_INVALID_DATETIME, "Field '" + field.name + "' is not a valid ISO 8601 datetime", "date-time", actual_repr)
                            )
                        data.set_str(field.name, raw_str)

                    elif field.kind == "int":
                        iv_opt: int | None = None
                        try:
                            iv_opt = row.get_int(col_idx)
                        except ValueError as e:
                            pass
                        if iv_opt is None:
                            err_list.append(
                                FieldError(field.name, CODE_TYPE_MISMATCH, "Column '" + field.name + "' expected integer", "int", actual_repr)
                            )
                        else:
                            iv: int = iv_opt
                            if field.has_min_int:
                                if field.is_exclusive_min:
                                    if iv <= field.min_val_int:
                                        err_list.append(FieldError(field.name, CODE_OUT_OF_RANGE, "Field '" + field.name + "' must be strictly greater than " + str(field.min_val_int), "> " + str(field.min_val_int), str(iv)))
                                else:
                                    if iv < field.min_val_int:
                                        err_list.append(FieldError(field.name, CODE_OUT_OF_RANGE, "Field '" + field.name + "' must be at least " + str(field.min_val_int), ">= " + str(field.min_val_int), str(iv)))
                            if field.has_max_int:
                                if field.is_exclusive_max:
                                    if iv >= field.max_val_int:
                                        err_list.append(FieldError(field.name, CODE_OUT_OF_RANGE, "Field '" + field.name + "' must be strictly less than " + str(field.max_val_int), "< " + str(field.max_val_int), str(iv)))
                                else:
                                    if iv > field.max_val_int:
                                        err_list.append(FieldError(field.name, CODE_OUT_OF_RANGE, "Field '" + field.name + "' must be at most " + str(field.max_val_int), "<= " + str(field.max_val_int), str(iv)))
                            if len(field.choices_int) > 0:
                                matched_chi: bool = False
                                chii: int = 0
                                while chii < len(field.choices_int):
                                    if field.choices_int[chii] == iv:
                                        matched_chi = True
                                    chii = chii + 1
                                if not matched_chi:
                                    err_list.append(FieldError(field.name, CODE_CHOICE_MISMATCH, "Field '" + field.name + "' must be one of the allowed integer choices", "choice", str(iv)))
                            data.set_int(field.name, iv)
                            data.set_str(field.name, raw_str)

                    elif field.kind == "float":
                        fv_opt: float | None = None
                        try:
                            fv_opt = row.get_float(col_idx)
                        except ValueError as e:
                            pass
                        if fv_opt is None:
                            err_list.append(
                                FieldError(field.name, CODE_TYPE_MISMATCH, "Column '" + field.name + "' expected float", "float", actual_repr)
                            )
                        else:
                            fv: float = fv_opt
                            if field.has_min:
                                if field.is_exclusive_min:
                                    if fv <= field.min_val:
                                        err_list.append(FieldError(field.name, CODE_OUT_OF_RANGE, "Field '" + field.name + "' must be strictly greater than " + str(field.min_val), "> " + str(field.min_val), str(fv)))
                                else:
                                    if fv < field.min_val:
                                        err_list.append(FieldError(field.name, CODE_OUT_OF_RANGE, "Field '" + field.name + "' must be at least " + str(field.min_val), ">= " + str(field.min_val), str(fv)))
                            if field.has_max:
                                if field.is_exclusive_max:
                                    if fv >= field.max_val:
                                        err_list.append(FieldError(field.name, CODE_OUT_OF_RANGE, "Field '" + field.name + "' must be strictly less than " + str(field.max_val), "< " + str(field.max_val), str(fv)))
                                else:
                                    if fv > field.max_val:
                                        err_list.append(FieldError(field.name, CODE_OUT_OF_RANGE, "Field '" + field.name + "' must be at most " + str(field.max_val), "<= " + str(field.max_val), str(fv)))
                            data.set_float(field.name, fv)
                            data.set_str(field.name, raw_str)

                    elif field.kind == "bool":
                        if raw_str == "1" or raw_str == "true" or raw_str == "TRUE" or raw_str == "t":
                            data.set_bool(field.name, True)
                            data.set_int(field.name, 1)
                        elif raw_str == "0" or raw_str == "false" or raw_str == "FALSE" or raw_str == "f":
                            data.set_bool(field.name, False)
                            data.set_int(field.name, 0)
                        else:
                            err_list.append(
                                FieldError(field.name, CODE_TYPE_MISMATCH, "Column '" + field.name + "' expected boolean (0/1 or true/false)", "bool", actual_repr)
                            )
            fi = fi + 1

        # 3. Custom validators
        cvi: int = 0
        while cvi < len(self.custom_validators):
            cv: (ValidatedData) -> list[FieldError] = self.custom_validators[cvi]
            extra_errs: list[FieldError] = cv(data)
            eei: int = 0
            while eei < len(extra_errs):
                err_list.append(extra_errs[eei])
                eei = eei + 1
            cvi = cvi + 1

        return ValidationResult(len(err_list) == 0, data, err_list)

    def validate_json(self: Schema, json_str: str) -> ValidationResult:
        try:
            v: JsonValue = nox.json.parse(json_str)
            return self.validate(v)
        except JsonError as e:
            data: ValidatedData = ValidatedData()
            errs: list[FieldError] = []
            errs.append(FieldError("root", CODE_INVALID_JSON, "Malformed JSON syntax: " + e.message, "valid JSON", "syntax error"))
            return ValidationResult(False, data, errs)

    def dump(self: Schema, data: ValidatedData) -> str:
        s: Serializer = Serializer()
        fi: int = 0
        while fi < len(self.fields):
            f: Field = self.fields[fi]
            out_key: str = f.name
            if len(f.json_name) > 0:
                out_key = f.json_name

            if data.is_null(f.name):
                s.null(out_key)
            elif data.has(f.name):
                if f.kind == "string":
                    s.str(out_key, data.get_str(f.name))
                elif f.kind == "int":
                    s.int(out_key, data.get_int(f.name))
                elif f.kind == "float":
                    s.float(out_key, data.get_float(f.name))
                elif f.kind == "bool":
                    s.bool(out_key, data.get_bool(f.name))
                elif f.kind == "object":
                    ns: Schema | None = f.nested_schema
                    if ns is not None:
                        sub_vd: ValidatedData = data.get_object(f.name)
                        sub_json: str = ns.dump(sub_vd)
                        s.raw_json(out_key, sub_json)
                elif f.kind == "list":
                    if f.item_kind == "string" or f.item_kind == "str":
                        s.list_str(out_key, data.get_list_str(f.name))
                    elif f.item_kind == "int":
                        s.list_int(out_key, data.get_list_int(f.name))
                    elif f.item_kind == "float":
                        s.list_float(out_key, data.get_list_float(f.name))
                    elif f.item_kind == "bool":
                        s.list_bool(out_key, data.get_list_bool(f.name))
                    elif f.item_kind == "object":
                        is_sub: Schema | None = f.item_schema
                        if is_sub is not None:
                            sub_objs: list[ValidatedData] = data.get_list_object(f.name)
                            jw: JsonWriter = JsonWriter()
                            jw.begin_array()
                            jwi: int = 0
                            while jwi < len(sub_objs):
                                item_json: str = is_sub.dump(sub_objs[jwi])
                                item_val: JsonValue = nox.json.parse(item_json)
                                jw.write_value(item_val)
                                jwi = jwi + 1
                            jw.end_array()
                            s.raw_json(out_key, jw.build())
            fi = fi + 1

        if self.policy == POLICY_ALLOW:
            s.include_extras(data)

        return s.build()

    def dump_validated(self: Schema, data: ValidatedData) -> str:
        raw_json: str = self.dump(data)
        res: ValidationResult = self.validate_json(raw_json)
        if not res.is_valid:
            raise ValidationError(res.errors)
        return raw_json

    def to_json_schema(self: Schema, include_defs: bool = True) -> str:
        w: JsonWriter = JsonWriter()
        w.begin_object()
        if include_defs:
            w.write_key("$schema")
            w.write_string("https://json-schema.org/draft/2020-12/schema")
        w.write_key("title")
        w.write_string(self.name)
        w.write_key("type")
        w.write_string("object")

        if include_defs:
            # Collect definitions for root $defs (including all nested schemas in tree)
            defs: list[Schema] = []
            di: int = 0
            while di < len(self.fields):
                df: Field = self.fields[di]
                df_ns: Schema | None = df.nested_schema
                if df_ns != None:
                    already: bool = False
                    si: int = 0
                    while si < len(defs):
                        if defs[si].name == df_ns.name:
                            already = True
                        si = si + 1
                    if not already:
                        defs.append(df_ns)
                df_is: Schema | None = df.item_schema
                if df_is != None:
                    already_it: bool = False
                    si2: int = 0
                    while si2 < len(defs):
                        if defs[si2].name == df_is.name:
                            already_it = True
                        si2 = si2 + 1
                    if not already_it:
                        defs.append(df_is)
                di = di + 1

            # Discover deeply nested schemas across collected definitions:
            q_idx: int = 0
            while q_idx < len(defs):
                curr_def: Schema = defs[q_idx]
                cfi: int = 0
                while cfi < len(curr_def.fields):
                    c_field: Field = curr_def.fields[cfi]
                    c_ns: Schema | None = c_field.nested_schema
                    if c_ns != None:
                        already_c: bool = False
                        csi: int = 0
                        while csi < len(defs):
                            if defs[csi].name == c_ns.name:
                                already_c = True
                            csi = csi + 1
                        if not already_c:
                            defs.append(c_ns)
                    c_is: Schema | None = c_field.item_schema
                    if c_is != None:
                        already_cis: bool = False
                        csi2: int = 0
                        while csi2 < len(defs):
                            if defs[csi2].name == c_is.name:
                                already_cis = True
                            csi2 = csi2 + 1
                        if not already_cis:
                            defs.append(c_is)
                    cfi = cfi + 1
                q_idx = q_idx + 1

            if len(defs) > 0:
                w.write_key("$defs")
                w.begin_object()
                sdi: int = 0
                while sdi < len(defs):
                    sub_s: Schema = defs[sdi]
                    w.write_key(sub_s.name)
                    sub_json: str = sub_s.to_json_schema(False)
                    sub_val: JsonValue = nox.json.parse(sub_json)
                    w.write_value(sub_val)
                    sdi = sdi + 1
                w.end_object()

        # Properties
        w.write_key("properties")
        w.begin_object()
        fi: int = 0
        while fi < len(self.fields):
            f: Field = self.fields[fi]
            prop_key: str = f.name
            if len(f.json_name) > 0:
                prop_key = f.json_name

            w.write_key(prop_key)
            w.begin_object()

            is_nullable: bool = (f.mode == MODE_REQUIRED_NULLABLE or f.mode == MODE_OPTIONAL_NULLABLE)

            if f.kind == "string":
                w.write_key("type")
                if is_nullable:
                    w.begin_array()
                    w.write_string("string")
                    w.write_string("null")
                    w.end_array()
                else:
                    w.write_string("string")
                if f.has_min_len:
                    w.write_key("minLength")
                    w.write_int(f.min_len)
                if f.has_max_len:
                    w.write_key("maxLength")
                    w.write_int(f.max_len)
                if len(f.pattern) > 0:
                    w.write_key("pattern")
                    w.write_string(f.pattern)
                if len(f.fmt) > 0:
                    w.write_key("format")
                    if f.fmt == "url":
                        w.write_string("uri")
                    else:
                        w.write_string(f.fmt)
                if len(f.choices) > 0:
                    w.write_key("enum")
                    w.begin_array()
                    ei: int = 0
                    while ei < len(f.choices):
                        w.write_string(f.choices[ei])
                        ei = ei + 1
                    w.end_array()

            elif f.kind == "int":
                w.write_key("type")
                if is_nullable:
                    w.begin_array()
                    w.write_string("integer")
                    w.write_string("null")
                    w.end_array()
                else:
                    w.write_string("integer")
                if f.has_min_int:
                    if f.is_exclusive_min:
                        w.write_key("exclusiveMinimum")
                    else:
                        w.write_key("minimum")
                    w.write_int(f.min_val_int)
                elif f.has_min:
                    if f.is_exclusive_min:
                        w.write_key("exclusiveMinimum")
                    else:
                        w.write_key("minimum")
                    w.write_int(int(f.min_val))
                if f.has_max_int:
                    if f.is_exclusive_max:
                        w.write_key("exclusiveMaximum")
                    else:
                        w.write_key("maximum")
                    w.write_int(f.max_val_int)
                elif f.has_max:
                    if f.is_exclusive_max:
                        w.write_key("exclusiveMaximum")
                    else:
                        w.write_key("maximum")
                    w.write_int(int(f.max_val))
                if len(f.choices_int) > 0:
                    w.write_key("enum")
                    w.begin_array()
                    eii: int = 0
                    while eii < len(f.choices_int):
                        w.write_int(f.choices_int[eii])
                        eii = eii + 1
                    w.end_array()

            elif f.kind == "float":
                w.write_key("type")
                if is_nullable:
                    w.begin_array()
                    w.write_string("number")
                    w.write_string("null")
                    w.end_array()
                else:
                    w.write_string("number")
                if f.has_min:
                    if f.is_exclusive_min:
                        w.write_key("exclusiveMinimum")
                    else:
                        w.write_key("minimum")
                    w.write_float(f.min_val)
                if f.has_max:
                    if f.is_exclusive_max:
                        w.write_key("exclusiveMaximum")
                    else:
                        w.write_key("maximum")
                    w.write_float(f.max_val)

            elif f.kind == "bool":
                w.write_key("type")
                if is_nullable:
                    w.begin_array()
                    w.write_string("boolean")
                    w.write_string("null")
                    w.end_array()
                else:
                    w.write_string("boolean")

            elif f.kind == "object":
                f_ns: Schema | None = f.nested_schema
                if f_ns != None:
                    if is_nullable:
                        w.write_key("anyOf")
                        w.begin_array()
                        w.begin_object()
                        w.write_key("$ref")
                        w.write_string("#/$defs/" + f_ns.name)
                        w.end_object()
                        w.begin_object()
                        w.write_key("type")
                        w.write_string("null")
                        w.end_object()
                        w.end_array()
                    else:
                        w.write_key("$ref")
                        w.write_string("#/$defs/" + f_ns.name)
                else:
                    w.write_key("type")
                    if is_nullable:
                        w.begin_array()
                        w.write_string("object")
                        w.write_string("null")
                        w.end_array()
                    else:
                        w.write_string("object")

            elif f.kind == "list":
                w.write_key("type")
                if is_nullable:
                    w.begin_array()
                    w.write_string("array")
                    w.write_string("null")
                    w.end_array()
                else:
                    w.write_string("array")
                if f.has_min_items:
                    w.write_key("minItems")
                    w.write_int(f.min_items)
                if f.has_max_items:
                    w.write_key("maxItems")
                    w.write_int(f.max_items)
                w.write_key("items")
                w.begin_object()
                f_is: Schema | None = f.item_schema
                if f_is != None:
                    w.write_key("$ref")
                    w.write_string("#/$defs/" + f_is.name)
                elif f.item_kind == "string":
                    w.write_key("type")
                    w.write_string("string")
                elif f.item_kind == "int":
                    w.write_key("type")
                    w.write_string("integer")
                elif f.item_kind == "float":
                    w.write_key("type")
                    w.write_string("number")
                elif f.item_kind == "bool":
                    w.write_key("type")
                    w.write_string("boolean")
                w.end_object()

            if f.has_default:
                w.write_key("default")
                if f.kind == "string":
                    w.write_string(f.default_str)
                elif f.kind == "int":
                    w.write_int(f.default_int)
                elif f.kind == "float":
                    w.write_float(f.default_float)
                elif f.kind == "bool":
                    w.write_bool(f.default_bool)

            if len(f.description) > 0:
                w.write_key("description")
                w.write_string(f.description)

            w.end_object()
            fi = fi + 1
        w.end_object()

        # Required fields list
        reqs: list[str] = []
        ri: int = 0
        while ri < len(self.fields):
            f_req: Field = self.fields[ri]
            if f_req.mode == MODE_REQUIRED or f_req.mode == MODE_REQUIRED_NULLABLE:
                prop_name: str = f_req.name
                if len(f_req.json_name) > 0:
                    prop_name = f_req.json_name
                reqs.append(prop_name)
            ri = ri + 1

        w.write_key("required")
        w.begin_array()
        qi: int = 0
        while qi < len(reqs):
            w.write_string(reqs[qi])
            qi = qi + 1
        w.end_array()

        w.write_key("additionalProperties")
        w.write_bool(self.policy != POLICY_FORBID)

        w.end_object()
        return w.build()
